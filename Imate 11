function ugandaNow(){ return new Date(); }
function daysBetween(startIso, endDate){
  var s = new Date(startIso);
  try { s = new Date(new Date(startIso).toLocaleString("en-US", { timeZone: "UTC" })); } catch(e){}
  var e = endDate || ugandaNow();
  var s0 = new Date(s.getFullYear(), s.getMonth(), s.getDate());
  var e0 = new Date(e.getFullYear(), e.getMonth(), e.getDate());
  return Math.max(0, Math.floor((e0 - s0) / 86400000));
}
function compoundsElapsed(m){
  if(!m || !m.start) return 0;
  try {
    var start = new Date(m.start);
    var ugStart = new Date(start.toLocaleString("en-US", { timeZone: "UTC" }));
    var day0 = new Date(ugStart.getFullYear(), ugStart.getMonth(), ugStart.getDate());
    var now = ugandaNow();
    var dayN = new Date(now.getFullYear(), now.getMonth(), now.getDate());
    var diff = Math.floor((dayN.getTime() - day0.getTime()) / 86400000);
    return Math.max(0, diff);
  } catch(e){ return 0; }
}
function principalWithBonus(price){
  return Math.round(Number(price) * (1 + BONUS_RATE) * 100) / 100;
}
function compoundValue(principal, compounds){
  var v = Number(principal) || 0;
  var n = Math.max(0, Math.floor(Number(compounds) || 0));
  for(var i=0;i<n;i++) v = v * (1 + DAILY_COMPOUND);
  return Math.round(v * 100) / 100;
}
function machineCurrentValue(m){
  var principal = m.principal != null ? m.principal : Number(m.price||0);
  var lockDays = Number(m.lockDays || 7);
  var days = Math.min(compoundsElapsed(m), lockDays);
  return compoundValue(principal, days);
}
function machineProjectedFinal(m){
  var principal = m.principal != null ? m.principal : Number(m.price||0);
  return compoundValue(principal, Number(m.lockDays || 7));
}
function machineEarned(m){
  return Math.max(0, machineCurrentValue(m) - Number(m.price||0));
}

function calcBalances(user){
  if(user.machines){
    for(var i=0;i<user.machines.length;i++){
      var m = user.machines[i];
      var lockDays = Number(m.lockDays || 7);
      var elapsed = compoundsElapsed(m);
      if(!m.credited && elapsed >= lockDays){
        var finalBal = machineProjectedFinal(m);
        user.balance = (user.balance || 0) + finalBal;
        m.credited = true;
        m.finalValue = finalBal;
        user.transactions = user.transactions || [];
        user.transactions.unshift({
          date: new Date().toLocaleString(),
          type: "Lock complete — "+(m.name||"Machine")+" to Balance",
          amount: finalBal
        });
        try{ safeStorage.setItem("iMate1", JSON.stringify(state)); }catch(e){}
      }
    }
  }
  var available = (user.balance||0) - (user.pendingWithdraw||0);
  if(available < 0) available = 0;
  var locked = 0;
  if(user.machines){
    for(var j=0;j<user.machines.length;j++){
      if(!user.machines[j].credited) locked += machineCurrentValue(user.machines[j]);
    }
  }
  return { available: available, locked: locked };
}

