        html += '<div class="detail-row"><div><b>'+(mx.name||"Machine")+'</b></div><div class="when">Starts compounding from next day</div></div>';
        continue;
      }
      var pr = mx.principal != null ? mx.principal : principalWithBonus(mx.price);
      var before = compoundValue(pr, el-1);
      var nowv = compoundValue(pr, el);
      html += '<div class="detail-row"><div><b>'+(mx.name||"Machine")+'</b> · day '+el+'</div>'+
        '<div class="amt green">+'+money(Math.max(0,nowv-before))+'</div>'+
        '<div class="when">'+money(before)+' → '+money(nowv)+'</div></div>';
    }
    if(!ms2.length) html += '<div class="empty">No active shares</div>';
  }
  else if(kind === "invites"){
