<script>
const API = location.origin;
let token = localStorage.getItem('imate1_admin_token') || '';

const money = n => 'UGX ' + Number(n||0).toLocaleString('en-US',{maximumFractionDigits:0});

async function api(path, opts={}){
  const headers = {'Content-Type':'application/json'};
  if(token) headers['Authorization'] = 'Bearer ' + token;
  const res = await fetch(API + path, {...opts, headers});
  const data = await res.json().catch(()=>({}));
  if(res.status === 401){ logout(); throw new Error('Unauthorized'); }
  if(!res.ok) throw new Error(data.error || 'Error');
  return data;
}

function showDash(on){
  document.getElementById('loginView').classList.toggle('hidden', on);
  document.getElementById('dashView').classList.toggle('hidden', !on);
}

async function adminLogin(){
  try{
    const data = await api('/api/login', {
      method:'POST',
      body: JSON.stringify({
        identifier: document.getElementById('adminEmail').value.trim(),
        password: document.getElementById('adminPass').value
      })
    });
    if(!data.user.is_admin){
      alert('This account is not an admin.');
      return;
    }
    token = data.token;
    localStorage.setItem('imate1_admin_token', token);
    showDash(true);
    loadAll();
  }catch(e){ alert(e.message); }
}

function logout(){
  token = '';
  localStorage.removeItem('imate1_admin_token');
  showDash(false);
}

async function loadAll(){
  try{
    const [stats, wds, users] = await Promise.all([
      api('/api/admin/stats'),
      api('/api/admin/withdrawals'),
      api('/api/admin/users')
    ]);
    document.getElementById('sUsers').textContent = stats.total_users;
    document.getElementById('sInvested').textContent = money(stats.total_invested);
    document.getElementById('sPending').textContent = stats.pending_withdrawals;
    document.getElementById('sPendingAmt').textContent = money(stats.pending_amount);
    document.getElementById('sRefPay').textContent = money(stats.total_referral_payouts || 0);

    // Withdrawals table
    const wdEl = document.getElementById('wdTable');
    if(!wds.withdrawals.length){
      wdEl.innerHTML = '<div class="empty">No withdrawal requests yet.</div>';
    } else {
      wdEl.innerHTML = `<table>
        <thead><tr>
          <th>Date</th><th>User</th><th>Phone</th><th>Amount</th><th>Fee</th><th>Net</th><th>Status</th><th>Action</th>
        </tr></thead>
        <tbody>${wds.withdrawals.map(w=>`
          <tr>
            <td>${new Date(w.created_at).toLocaleString()}</td>
            <td>${w.user_name||'—'}</td>
            <td>${w.user_phone||'—'}</td>
            <td>${money(w.amount)}</td>
            <td>${money(w.fee)}</td>
            <td class="green">${money(w.net)}</td>
            <td><span class="badge ${w.status}">${w.status}</span></td>
            <td>${w.status==='pending' ? `
              <button class="btn approve" onclick="act('${w.id}','approve')">Approve</button>
              <button class="btn reject" onclick="act('${w.id}','reject')">Reject</button>
            ` : (w.admin_note || '—')}</td>
          </tr>`).join('')}
        </tbody></table>`;
    }

    // Users table
    const uEl = document.getElementById('usersTable');
    uEl.innerHTML = `<table>
      <thead><tr>
        <th>Name</th><th>Phone</th><th>Email</th><th>Balance</th><th>Machines</th><th>Referrals</th><th>Joined</th>
      </tr></thead>
      <tbody>${users.users.map(u=>`
        <tr>
          <td>${u.name}${u.is_admin?' <span class="badge approved">ADMIN</span>':''}</td>
          <td>${u.phone}</td>
          <td>${u.email}</td>
          <td class="orange">${money(u.balance)}</td>
          <td>${(u.machines||[]).length}</td>
          <td>${u.referral_count||0}</td>
          <td>${u.created_at ? new Date(u.created_at).toLocaleDateString() : '—'}</td>
        </tr>`).join('')}
      </tbody></table>`;
  }catch(e){
    console.error(e);
    if(e.message.includes('Unauthorized')||e.message.includes('Admin')) logout();
  }
}

async function act(id, action){
  const note = action==='reject' ? prompt('Rejection reason (optional):') || '' : '';
  try{
    await api('/api/admin/withdrawals/action', {
      method:'POST',
      body: JSON.stringify({id, action, note})
