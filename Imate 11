    html += '<div class="notice">Total mining gain so far: <b class="green">'+money(mi)+'</b></div>';
    var ms = user.machines || [];
    if(!ms.length) html += '<div class="empty">No shares yet</div>';
    for(var m=0;m<ms.length;m++){
      var mm = ms[m];
      var cur = machineCurrentValue(mm);
      var gain = Math.max(0, cur - Number(mm.price||0));
      var elap = compoundsElapsed(mm);
      html += '<div class="detail-row"><div><b>'+(mm.name||"Machine")+'</b> · day '+elap+'/'+(mm.lockDays||7)+
        (mm.credited?' · <span class="badge-ok">released</span>':' · <span class="badge-pend">locked</span>')+'</div>'+
        '<div class="amt green">+'+money(gain)+' gain</div>'+
        '<div class="when">Started '+(mm.start?new Date(mm.start).toLocaleString():"—")+' · Now '+money(cur)+'</div></div>';
    }
  }
  else if(kind === "today"){
    title.textContent = "Today's earnings";
    var te = todayEarnings(user);
    html += '<div class="notice">Earned today (compound growth): <b class="green">'+money(te)+'</b></div>';
    html += '<div class="muted">Updates each day as locked balances grow by 5% compound.</div>';
    var ms2 = user.machines || [];
    for(var k=0;k<ms2.length;k++){
      var mx = ms2[k];
