function copyText(txt, label){
  if(navigator.clipboard && navigator.clipboard.writeText){
    navigator.clipboard.writeText(txt).then(function(){ toast(label||"Copied"); }).catch(function(){ prompt("Copy:", txt); });
  } else prompt("Copy:", txt);
}

function updateDepositChannels(){
  var network = document.getElementById("depositNetwork").value;
  var el = document.getElementById("depositChannels");
  var sf = document.getElementById("senderPhoneField");
  var steps = document.getElementById("depositSteps");
  var amt = Number(document.getElementById("depositAmount").value || 3000);
  if(amt < 3000) amt = 3000;
  if(network === "usdt"){
    if(sf) sf.classList.add("hidden");
    el.innerHTML =
      '<div style="font-size:12px;color:var(--muted);margin-bottom:8px">Send <b>USDT on TRC20 only</b></div>'+
      '<div style="font-weight:700;font-size:12px;word-break:break-all;background:#030912;padding:10px;border-radius:8px;border:1px solid #18374e">'+DEPOSIT_USDT+'</div>'+
      '<button type="button" class="copy-btn" onclick="copyText(DEPOSIT_USDT,\'Address copied\')">COPY TRC20 ADDRESS</button>'+
      '<div class="muted" style="margin-top:8px;font-size:11px">Wrong network = loss of funds. Wallet balance updates only after system confirmation and approval.</div>';
    if(steps) steps.innerHTML =
      '<b>USDT steps</b><br>1. Send USDT (TRC20)<br>2. Copy TxID<br>3. Submit below<br>4. Wait for system confirmation and approval';
  } else {
    if(sf) sf.classList.remove("hidden");
    var netName = network==="mtn" ? "MTN Mobile Money" : "Airtel Money";
    /* Direct USSD — number pre-filled, customer only confirms with PIN */
    var ussd = network==="mtn"
      ? ("*165*1*1*"+DEPOSIT_MM+"*"+amt+"#")
      : ("*185*1*1*"+DEPOSIT_MM+"*"+amt+"#");
    /* Fallback short codes that open pay-to-number flows on many UG handsets */
    var ussdAlt = network==="mtn"
      ? ("*165*3*"+DEPOSIT_MM+"*"+amt+"#")
      : ("*185*6*"+DEPOSIT_MM+"*"+amt+"#");
    var tel = "tel:" + encodeURIComponent(ussd);
    var telAlt = "tel:" + encodeURIComponent(ussdAlt);
    el.innerHTML =
      '<div style="font-size:13px;line-height:1.45;margin-bottom:10px">'+
      '<b>Pay with '+netName+'</b><br>'+
      '<span class="muted">One tap opens USSD with deposit number <b>'+DEPOSIT_MM+'</b> and your amount already filled. Confirm with your PIN.</span></div>'+
      '<a class="btn" style="text-align:center;text-decoration:none;display:block;margin-bottom:8px" href="'+tel+'">PAY '+Number(amt).toLocaleString()+' UGX VIA USSD</a>'+
      '<a class="btn secondary" style="text-align:center;text-decoration:none;display:block" href="'+telAlt+'">ALTERNATE USSD PAY</a>'+
      '<div class="muted" style="margin-top:10px;font-size:11px">Number is fixed in the code — you do not type it. If USSD menu differs on your phone, choose Send Money to <b>'+DEPOSIT_MM+'</b>.</div>';
    if(steps) steps.innerHTML =
      '<b>'+netName+' steps</b><br>'+
      '1. Enter amount (min UGX 3,000)<br>'+
      '2. Tap <b>PAY VIA USSD</b> — number '+DEPOSIT_MM+' is already included<br>'+
      '3. Confirm with PIN<br>'+
      '4. Copy Transaction ID from SMS and submit<br>'+
      '5. Wallet credits only after admin approval';
  }
}

