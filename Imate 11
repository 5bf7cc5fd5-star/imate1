function doWithdraw(){
  var user = currentUser(); if(!user) return;
  if(user.withdrawPassword){
    var wp = prompt("Enter your withdraw fund password:");
    if(wp === null) return;
    if(String(wp) !== String(user.withdrawPassword)){ alert("Wrong withdraw password"); return; }
  } else {
    alert("Please set a Withdraw fund password in Settings first.");
    openSettings();
    return;
  }

  var user=currentUser(); if(!user) return;
  var bals=calcBalances(user);
  var amount=Number(document.getElementById("withdrawAmount").value||0);
  if(amount<=0){ alert("Enter amount"); return; }
  if(amount>bals.available){ alert("Not enough available balance.\nMachine earnings move to Balance only after the 5-day cycle completes."); return; }
  user.withdrawals = user.withdrawals || [];
  var fee=Math.round(amount*0.05*100)/100;
  /* Hold funds as pending — do NOT remove from balance until admin approves */
  user.withdrawals.unshift({
    id:"w_"+Date.now(), amount:amount, fee:fee, net:amount-fee,
    status:"pending", date:new Date().toLocaleString()
  });
  user.pendingWithdraw = (user.pendingWithdraw||0) + amount;
  user.transactions = user.transactions || [];
  user.transactions.unshift({date:new Date().toLocaleString(), type:"Withdrawal request", amount:0});
  closeModal("withdrawModal"); save();
  toast("Withdrawal submitted.");
}


