/* ===== AUTH: sports only (football + racing) ===== */
#authScreen{
  background:
    radial-gradient(ellipse at 20% 10%, rgba(0,120,255,.25), transparent 50%),
    radial-gradient(ellipse at 80% 80%, rgba(200,30,30,.2), transparent 45%),
