function userRaffleTickets(user){
  if(!user) return 0;
  var tix = Number(user.raffleTickets || 0);
  return tix < 0 ? 0 : tix;
}
function renderRaffle(){
  var user = currentUser();
  var list = document.getElementById("raffleList");
  var locked = document.getElementById("raffleLocked");
  var stage = document.getElementById("raffleStage");
  var info = document.getElementById("raffleTicketInfo");
  if(!list) return;
  var hasPurchase = !!(user && user.machines && user.machines.length > 0);
  var tix = userRaffleTickets(user);
  if(info){
    if(!user) info.textContent = "Log in to play raffles";
    else if(!hasPurchase) info.textContent = "Cards below · Buy shares to unlock play (tickets included with each product)";
    else info.textContent = "Raffle tickets left: " + tix;
  }
  /* Always show cards — never leave blank */
  if(locked){
    if(!hasPurchase) locked.classList.remove("hidden");
    else locked.classList.add("hidden");
  }
  if(stage) stage.classList.remove("hidden");
  var h = "";
  for(var i=0;i<raffleCards.length;i++){
    var r = raffleCards[i];
    var canPlay = hasPurchase && tix > 0;
    h += '<div class="raffle-card" id="rcard'+r.id+'" onclick="flipRaffleCard('+r.id+')" style="'+(canPlay?'':'opacity:0.92')+'">'+
      '<div class="inner">'+
      '<div class="face back"><img src="'+r.photo+'" alt="'+r.theme+'" loading="lazy" onerror="this.onerror=null;this.src=\''+(r.photoFb||r.photo)+'\'"/></div>'+
      '<div class="face front"><img src="'+r.photo+'" alt=""/><div class="label">Raffle</div></div>'+
      '</div></div>';
  }
  list.innerHTML = h;
}
function flipRaffleCard(id){
  var user = currentUser(); if(!user) return;
  if(!user.machines || !user.machines.length){
    toast("Buy club shares first to unlock raffles");
    return;
  }
  var el = document.getElementById("rcard"+id);
  if(!el) return;
  if(el.classList.contains("flipped")) return;
  if(userRaffleTickets(user) <= 0){
    toast("No raffle tickets left — buy more shares");
    return;
  }
  el.classList.add("flipped");
  /* spend 1 ticket to reveal/enter */
  user.raffleTickets = userRaffleTickets(user) - 1;
  var card = null;
  for(var i=0;i<raffleCards.length;i++) if(raffleCards[i].id===id){ card=raffleCards[i]; break; }
  user.raffleEntries = user.raffleEntries || [];
  user.raffleEntries.unshift({
    id: "rf_"+Date.now(),
    raffleId: id,
    name: card ? card.name : ("R"+id),
    theme: card ? card.theme : "",
    price: card ? card.price : 0,
    date: new Date().toLocaleString(),
    status: "revealed"
  });
  user.transactions = user.transactions || [];
  user.transactions.unshift({
    date: new Date().toLocaleString(),
    type: "Raffle reveal — "+(card?card.theme:id)+" (1 ticket)",
    amount: 0
  });
  save();
  renderRaffle();
  toast((card?card.theme:"Card")+" revealed!");
}
function enterRaffle(id){ flipRaffleCard(id); }




function getDirectReferrals(user){
  var list = [];
  if(!user) return list;
  for(var i=0;i<state.users.length;i++){
    var u = state.users[i];
    if(!u || u.isAdmin) continue;
    if(u.referredBy === user.id || u.referredBy === user.inviteCode) list.push(u);
  }
  return list;
}
function getTeamRecursive(user, depth, maxDepth, acc){
  if(!user || depth > maxDepth) return acc;
  var directs = getDirectReferrals(user);
  for(var i=0;i<directs.length;i++){
    var d = directs[i];
    if(acc.ids[d.id]) continue;
    acc.ids[d.id] = true;
    acc.list.push({user:d, level:depth});
    getTeamRecursive(d, depth+1, maxDepth, acc);
  }
  return acc;
}
function miningIncomeTotal(user){
  if(!user) return 0;
  var total = 0;
  var ms = user.machines || [];
  for(var i=0;i<ms.length;i++){
    var m = ms[i];
    var cur = machineCurrentValue(m);
    var base = Number(m.price||0);
    total += Math.max(0, cur - base);
  }
  /* also count credited released gains from transactions */
  var txs = user.transactions || [];
  for(var j=0;j<txs.length;j++){
    var ty = (txs[j].type||"");
    if(ty.indexOf("Lock complete")>=0 || ty.indexOf("Mining")>=0 || ty.indexOf("compound")>=0){
      if(Number(txs[j].amount)>0) total += 0; /* already in machine path when credited */
    }
  }
  return total;
}
function todayEarnings(user){
  if(!user) return 0;
  var total = 0;
  var ms = user.machines || [];
  for(var i=0;i<ms.length;i++){
    var m = ms[i];
    if(m.credited) continue;
    var elap = compoundsElapsed(m);
    if(elap <= 0) continue;
    var principal = m.principal != null ? m.principal : principalWithBonus(m.price);
    var before = compoundValue(principal, elap - 1);
    var now = compoundValue(principal, elap);
    if(elap > (m.lockDays||7)) continue;
    total += Math.max(0, now - before);
  }
  return total;
}
function depositTotalConfirmed(user){
  var t = 0;
  var deps = (user && user.deposits) || [];
  for(var i=0;i<deps.length;i++){
    if(deps[i].status === "confirmed") t += Number(deps[i].amount||0);
  }
  return t;
}
function withdrawBreakdown(user){
  var pending=0, approved=0, rejected=0;
  var ws = (user && user.withdrawals) || [];
  for(var i=0;i<ws.length;i++){
    var st = (ws[i].status||"pending").toLowerCase();
    var a = Number(ws[i].amount||0);
    if(st==="pending") pending += a;
    else if(st==="approved" || st==="paid" || st==="completed") approved += a;
    else if(st==="rejected") rejected += a;
  }
  return {pending:pending, approved:approved, rejected:rejected, list:ws};
}
