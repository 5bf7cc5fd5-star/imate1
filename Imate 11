function setLeagueFilter(league, btn){
  leagueFilter = league || "all";
  var tabs = document.querySelectorAll("#leagueTabs button");
  for(var i=0;i<tabs.length;i++) tabs[i].classList.remove("active");
  if(btn) btn.classList.add("active");
  applyLeagueAtmosphere(leagueFilter);
  renderMachines();
}
function applyLeagueAtmosphere(league){
  var fx = document.getElementById("leagueFx");
  var hero = document.getElementById("leagueHero");
  var title = document.getElementById("leagueHeroTitle");
  var sub = document.getElementById("leagueHeroSub");
  var map = {
    "Premier League": "pl",
    "La Liga": "laliga",
    "Serie A": "seriea",
    "Ligue 1": "ligue1",
    "Bundesliga": "bundesliga",
    "Saudi Pro League": "saudi",
    "MLS": "mls",
    "Championship": "championship"
  };
  if(fx){
    fx.className = "league-fx";
    if(league && league !== "all" && map[league]){
      fx.classList.add("on", map[league]);
    }
  }
  if(hero){
    hero.className = "league-hero";
    if(league && league !== "all" && map[league]){
      hero.classList.add("on", map[league]);
      if(title) title.textContent = league;
      if(sub) sub.textContent = "Own Club · Share Market · Daily coupon return";
    } else {
      hero.classList.remove("on");
    }
  }
}
function applyClubAtmosphere(club){
  var fx = document.getElementById("leagueFx");
  if(!fx) return;
  /* keep current league class, intensify */
  fx.classList.add("on");
  fx.style.filter = "saturate(1.25) brightness(1.05)";
  setTimeout(function(){ if(fx) fx.style.filter = ""; }, 1200);
  toast((club||"Club") + " selected");
}

function renderMachines(){
  var list = document.getElementById("machineList"); if(!list) return;
  var arr = machines.slice();
  if(leagueFilter && leagueFilter !== "all"){
    arr = arr.filter(function(m){ return (m.league||m.theme) === leagueFilter; });
  }
  var h = "";
  if(!arr.length) h = '<div class="empty">No clubs in this league</div>';
  else {
    var currentLeague = "";
    for(var i=0;i<arr.length;i++){
      var m = arr[i];
      var lg = m.league || m.theme || "";
      if(leagueFilter === "all" && lg !== currentLeague){
        currentLeague = lg;
        h += '<h3 style="margin:14px 0 8px;color:#3db8ff;font-size:14px;grid-column:1/-1">'+currentLeague+'</h3>';
      }
      h += machineCard(m);
    }
  }
  list.innerHTML = h;
}



