      '<div class="kpi"><span>Pending audit</span><b class="badge-pend">'+money(wb.pending)+'</b></div>'+
      '<div class="kpi"><span>Audited / withdrawn</span><b class="badge-ok">'+money(wb.approved)+'</b></div>'+
      '<div class="kpi"><span>Rejected</span><b class="badge-bad">'+money(wb.rejected)+'</b></div></div>';
    html += '<div class="detail-section"><h4>History</h4>';
    if(!wb.list.length) html += '<div class="empty">No withdrawals yet</div>';
    for(var w=0;w<wb.list.length;w++){
      var x = wb.list[w];
      var st = x.status||"pending";
      var cls = st==="pending"?"badge-pend":(st==="rejected"?"badge-bad":"badge-ok");
      html += '<div class="detail-row"><div><b>Withdrawal</b> · <span class="'+cls+'">'+st+'</span></div>'+
