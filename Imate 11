/** Fetch live rates (open.er-api.com — free, no key). Base USD. */
function fetchFxRates(force){
  var now = Date.now();
  if(!force && fxRates && (now - fxUpdatedAt) < FX_CACHE_MS){
    return Promise.resolve(fxRates);
  }
  var url = "/api/fx";
  // fallback to public API if local proxy missing
  var direct = "https://open.er-api.com/v6/latest/USD";
  return fetch(url).then(function(r){
    if(!r.ok) return fetch(direct).then(function(r2){ return r2.json(); });
    return r.json();
  }).then(function(data){
    if(data && data.result === "success" && data.rates){
      fxRates = data.rates;
      fxUpdatedAt = Date.now();
      try { localStorage.setItem("imate1_fx", JSON.stringify({rates: fxRates, at: fxUpdatedAt})); } catch(e){}
      try { if(typeof render === "function") render(); } catch(e){}
      return fxRates;
    }
    throw new Error("FX API failed");
  }).catch(function(err){
    console.warn("FX API offline, using fallback rates", err);
    // try cache
    try {
      var cached = JSON.parse(localStorage.getItem("imate1_fx") || "null");
      if(cached && cached.rates){ fxRates = cached.rates; fxUpdatedAt = cached.at || 0; }
    } catch(e){}
    if(!fxRates){
      fxRates = {};
      for(var k in FX_FALLBACK_PER_USD) fxRates[k] = FX_FALLBACK_PER_USD[k];
    }
    return fxRates;
  });
}

function initCurrencyApi(){
  try {
    var cached = JSON.parse(localStorage.getItem("imate1_fx") || "null");
    if(cached && cached.rates){ fxRates = cached.rates; fxUpdatedAt = cached.at || 0; }
  } catch(e){}
  fetchFxRates(false);
  // refresh hourly while app open
  setInterval(function(){ fetchFxRates(true); }, FX_CACHE_MS);
}

