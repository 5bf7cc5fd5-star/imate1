    html += '<div class="detail-section"><h4>Members</h4>';
    if(!tree.list.length) html += '<div class="empty">No team members yet</div>';
    for(var t2=0;t2<tree.list.length;t2++){
      var node = tree.list[t2];
      var uu = node.user;
      html += '<div class="detail-row"><div><b>'+(uu.name||"—")+'</b> · Level '+node.level+
        ' · Shares: '+((uu.machines||[]).length)+'</div>'+
        '<div class="when">'+(uu.phone||uu.email||"")+'</div></div>';
    }
    html += '</div>';
  }
  else if(kind === "teamIncome"){
    title.textContent = "Team income";
    var ri = Number(user.referralEarnings||0);
    html += '<div class="notice">Total team / referral income: <b class="green">'+money(ri)+'</b></div>';
