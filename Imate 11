function approveWithdraw(wid){
  if(!canApproveWithdrawals()){ alert("Support staff cannot approve withdrawals. Contact full admin."); return; }
  var user=currentUser(); if(!user) return;
  for(var i=0;i<state.users.length;i++){
    var u=state.users[i];
    var ws=u.withdrawals||[];
    for(var j=0;j<ws.length;j++){
      if(ws[j].id===wid && ws[j].status==="pending"){
        ws[j].status="approved";
        u.balance=(u.balance||0)-ws[j].amount;
        u.pendingWithdraw=Math.max(0,(u.pendingWithdraw||0)-ws[j].amount);
        u.transactions=u.transactions||[];
        u.transactions.unshift({date:new Date().toLocaleString(), type:"Withdrawal approved", amount:-ws[j].amount});
        u.transactions.unshift({date:new Date().toLocaleString(), type:"5% withdrawal fee", amount:-ws[j].fee});
        save(); toast("Withdrawal approved"); return;
      }
    }
  }
}
