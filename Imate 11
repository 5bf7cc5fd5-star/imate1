function staffResetPassword(uid){
  if(!canManagePasswords()){ alert("Not allowed"); return; }
  var np = prompt("Enter new password for this customer:");
  if(!np || np.length < 4){ alert("Password too short"); return; }
  ensureState();
  for(var i=0;i<state.users.length;i++){
    if(state.users[i].id===uid){
      state.users[i].password = np;
      save();
      toast("Password updated");
      renderSupportPasswordPanel();
      return;
    }
  }
  alert("User not found");
}

