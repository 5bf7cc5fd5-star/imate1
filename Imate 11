/* League / club atmosphere layers */
.league-fx{
  pointer-events:none; position:fixed; inset:0; z-index:0; overflow:hidden; opacity:0;
  transition:opacity .45s ease;
}
.league-fx.on{opacity:1}
.league-fx .pitch{
  position:absolute; inset:-10%;
  background:
    radial-gradient(ellipse at 50% 120%, rgba(20,120,40,.35), transparent 55%),
    linear-gradient(180deg, rgba(0,20,10,.2), rgba(0,0,0,.55));
}
.league-fx .streaks{
  position:absolute; inset:0;
  background-image:
    linear-gradient(110deg, transparent 40%, rgba(255,255,255,.08) 50%, transparent 60%),
    linear-gradient(70deg, transparent 30%, rgba(255,220,80,.06) 48%, transparent 62%);
  background-size: 200% 200%;
  animation: sportSweep 7s linear infinite;
}
.league-fx.pl .glow{background:radial-gradient(circle at 30% 20%, rgba(60,20,120,.45), transparent 50%), radial-gradient(circle at 80% 60%, rgba(180,0,60,.25), transparent 45%)}
.league-fx.laliga .glow{background:radial-gradient(circle at 70% 15%, rgba(255,200,0,.35), transparent 45%), radial-gradient(circle at 20% 70%, rgba(200,20,20,.3), transparent 50%)}
.league-fx.seriea .glow{background:radial-gradient(circle at 50% 20%, rgba(0,80,200,.4), transparent 50%), radial-gradient(circle at 70% 80%, rgba(0,150,80,.2), transparent 45%)}
.league-fx.ligue1 .glow{background:radial-gradient(circle at 40% 30%, rgba(0,40,120,.45), transparent 50%), radial-gradient(circle at 75% 70%, rgba(220,30,50,.25), transparent 45%)}
.league-fx.bundesliga .glow{background:radial-gradient(circle at 50% 25%, rgba(220,40,40,.35), transparent 50%), radial-gradient(circle at 30% 80%, rgba(0,0,0,.35), transparent 45%)}
.league-fx.saudi .glow{background:radial-gradient(circle at 60% 20%, rgba(0,120,80,.4), transparent 50%), radial-gradient(circle at 20% 70%, rgba(200,170,40,.25), transparent 45%)}
.league-fx.mls .glow{background:radial-gradient(circle at 35% 25%, rgba(0,100,200,.4), transparent 50%), radial-gradient(circle at 80% 65%, rgba(220,50,30,.25), transparent 45%)}
.league-fx.championship .glow{background:radial-gradient(circle at 50% 30%, rgba(100,40,160,.35), transparent 50%), radial-gradient(circle at 25% 75%, rgba(0,80,40,.25), transparent 45%)}
.league-fx .glow{position:absolute; inset:0; animation: sportPulse 4s ease-in-out infinite alternate}
.league-fx .ball{
  position:absolute; width:18px; height:18px; border-radius:50%;
  background:radial-gradient(circle at 30% 30%, #fff, #ddd 40%, #333 70%);
  box-shadow:0 0 12px rgba(255,255,255,.35);
  animation: ballFloat 6s ease-in-out infinite;
}
.league-fx .ball:nth-child(3){left:12%; top:22%; animation-delay:.5s}
.league-fx .ball:nth-child(4){left:70%; top:35%; animation-delay:1.2s}
.league-fx .ball:nth-child(5){left:40%; top:70%; animation-delay:2s}
@keyframes sportSweep{0%{background-position:0% 50%}100%{background-position:100% 50%}}
@keyframes sportPulse{0%{opacity:.7;transform:scale(1)}100%{opacity:1;transform:scale(1.05)}}
@keyframes ballFloat{0%,100%{transform:translateY(0)}50%{transform:translateY(-18px)}}
.auth-sport-fx{
  position:absolute; inset:0; z-index:0; overflow:hidden; pointer-events:none;
}
.auth-sport-fx .ring{
  position:absolute; border:2px solid rgba(0,168,255,.25); border-radius:50%;
  animation: ringGrow 5s linear infinite;
}
.auth-sport-fx .ring:nth-child(1){width:120px;height:120px;left:10%;top:20%}
.auth-sport-fx .ring:nth-child(2){width:180px;height:180px;right:5%;top:40%;animation-delay:1.5s}
.auth-sport-fx .ring:nth-child(3){width:90px;height:90px;left:40%;bottom:15%;animation-delay:3s}
@keyframes ringGrow{0%{transform:scale(.6);opacity:0}40%{opacity:.5}100%{transform:scale(1.4);opacity:0}}
