}
.auth-sport-fx .pitch-lines{
  position:absolute; inset:10% 8%;
  border:2px solid rgba(255,255,255,.08);
  border-radius:12px;
  box-shadow:inset 0 0 40px rgba(0,200,80,.08);
}
.auth-sport-fx .pitch-lines:before{
  content:""; position:absolute; left:50%; top:0; bottom:0; width:2px;
  background:rgba(255,255,255,.08); transform:translateX(-50%);
}
.auth-sport-fx .pitch-lines:after{
  content:""; position:absolute; left:50%; top:50%; width:70px; height:70px;
  border:2px solid rgba(255,255,255,.08); border-radius:50%;
  transform:translate(-50%,-50%);
}
.auth-sport-fx .ball-sport{
  position:absolute; width:22px; height:22px; border-radius:50%;
  background:
    radial-gradient(circle at 35% 30%, #fff 0 25%, #e8e8e8 26% 40%, #222 41%);
  box-shadow:0 0 16px rgba(255,255,255,.4);
  animation:ballKick 5.5s ease-in-out infinite;
}
.auth-sport-fx .ball-sport.b2{ animation-delay:1.2s; animation-name:ballKick2; }
.auth-sport-fx .car{
  position:absolute; width:48px; height:18px; border-radius:6px;
  background:linear-gradient(90deg,#1a8cff,#0ff);
  box-shadow:0 0 18px rgba(0,180,255,.55);
  animation:carRace 4.2s linear infinite;
}
.auth-sport-fx .car:after{
  content:""; position:absolute; right:-6px; top:4px; width:10px; height:10px;
  background:#0ff; border-radius:2px; opacity:.8;
}
.auth-sport-fx .car.c2{
  background:linear-gradient(90deg,#ff3b3b,#ff9a00);
  box-shadow:0 0 18px rgba(255,80,0,.5);
  animation-delay:2.1s; top:auto; bottom:18%;
}
.auth-sport-fx .finish{
  position:absolute; right:8%; top:12%; bottom:12%; width:6px;
  background:repeating-linear-gradient(
    180deg, #fff 0 8px, #111 8px 16px
  );
  opacity:.25;
}
@keyframes ballKick{
  0%{ left:8%; top:70%; transform:scale(1); }
  40%{ left:55%; top:28%; transform:scale(1.15); }
  100%{ left:88%; top:62%; transform:scale(1); }
}
@keyframes ballKick2{
  0%{ left:90%; top:25%; }
  50%{ left:40%; top:55%; }
  100%{ left:12%; top:30%; }
}
@keyframes carRace{
  0%{ left:-20%; top:22%; }
  100%{ left:110%; top:22%; }
}

