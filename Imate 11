function selectMachine(id){
  selectedMachine = null;
  for(var i=0;i<machines.length;i++) if(machines[i].id===id){ selectedMachine=machines[i]; break; }
  if(!selectedMachine) return;
  try{applyLeagueAtmosphere(selectedMachine.league||selectedMachine.theme); applyClubAtmosphere(selectedMachine.code);}catch(e){}
  selectedTierWeeks = 1;
  selectedTierPrice = 35000;
  selectedLockDays = 7;
  var title = document.getElementById("buyTitle");
  if(title) title.textContent = selectedMachine.code + " — Buy Shares";
  var details = document.getElementById("buyDetails");
  if(details){
    var tiers = (typeof SHARE_TIERS !== "undefined" ? SHARE_TIERS : []);
    var th = '<div class="notice"><b>'+selectedMachine.code+'</b> · '+(selectedMachine.league||'')+
      (selectedMachine.marketValue?('<br>Club value <b class="blue">'+selectedMachine.marketValue+'</b>'):'')+'</div>';
    th += '<div class="muted" style="margin:8px 0">Choose how many weeks to lock. Price = <b>UGX 35,000 × weeks</b>. Earnings: <b>Daily coupon return</b> on your purchase.</div>';
    th += '<div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:10px">';
    for(var t=0;t<tiers.length;t++){
      var tr = tiers[t];
      var p0 = tr.price;
      var days = tr.weeks * 7;
      var finalBal = compoundValue(p0, days);
      var gain = finalBal - p0;
      th += '<button type="button" class="btn secondary lock-opt" data-weeks="'+tr.weeks+'" data-price="'+tr.price+'" onclick="pickShareTier('+tr.weeks+','+tr.price+')" style="margin:0;text-align:left;padding:12px">'+
        '<b>'+tr.label+'</b><br><span class="green">'+money(tr.price)+'</span><br><small style="color:#93a4b8">Daily coupon return · est. end '+money(finalBal)+'</small></button>';
    }
    th += '</div>';
    th += '<div class="kpi" style="margin-top:12px"><span>Selected</span><b id="tierSelectedLabel">1 week · '+money(35000)+'</b></div>';
    th += '<div class="muted" id="tierEstLine" style="margin-top:6px">Est. after lock (compound): <b class="green" id="tierEstVal">'+money(compoundValue(35000,7))+'</b></div>';
    details.innerHTML = th;
  }
  openClubBuyAtmosphere(selectedMachine);
  openModal("buyModal");
  pickShareTier(1, 35000);
}
function pickShareTier(weeks, price){
  selectedTierWeeks = weeks;
  selectedTierPrice = price;
  selectedLockDays = weeks * 7;
  var days = weeks * 7;
  var finalBal = compoundValue(price, days);
  var el = document.getElementById("tierSelectedLabel");
  if(el) el.innerHTML = weeks+" week"+(weeks>1?"s":"")+" · "+money(price);
  var ev = document.getElementById("tierEstVal");
  if(ev) ev.textContent = money(finalBal);
  var btns = document.querySelectorAll(".lock-opt");
  for(var i=0;i<btns.length;i++){
    var w = Number(btns[i].getAttribute("data-weeks"));
    btns[i].style.borderColor = (w===weeks) ? "#20e58b" : "";
    btns[i].style.boxShadow = (w===weeks) ? "0 0 12px rgba(32,229,139,.35)" : "";
  }
}

function pickLock(d){
  selectedLockDays = d;
  var p0 = selectedMachine ? principalWithBonus(selectedMachine.price) : 0;
  var el = document.getElementById("lockSelectedLabel");
  if(el) el.innerHTML = d+" Days → "+money(compoundValue(p0, d));
  var btns = document.querySelectorAll(".lock-opt");
  for(var i=0;i<btns.length;i++){
    var bd = Number(btns[i].getAttribute("data-days"));
    btns[i].style.border = bd===d ? "2px solid #20e58b" : "";
  }
}
function confirmPurchase(){
  if(!selectedMachine) return;
  var user = currentUser(); if(!user) return;
  var price = Number(selectedTierPrice || price || 35000);
  var lockDays = Number(selectedLockDays || (selectedTierWeeks||1)*7);
  if(lockDays < 7) lockDays = 7;
  if(lockDays > 28) lockDays = 28;
  var bals = calcBalances(user);
  if(bals.available < price){
    alert("Insufficient balance.\nNeed "+money(price)+".\nDeposit first and wait for system confirmation and approval.");
    return;
  }
  var principal = price;
  var bonusAmt = 0;
  user.balance = (user.balance || 0) - price;
  user.machines = user.machines || [];
  user.machines.push({
    id: Date.now(),
    machineId: selectedMachine.id,
    name: selectedMachine.code || selectedMachine.name,
    theme: selectedMachine.theme || "",
    start: ugandaNow().toISOString(),
    price: price,
    principal: principal,
    bonus: bonusAmt,
    lockDays: lockDays,
    dailyRate: DAILY_COMPOUND,
    credited: false
  });
  user.transactions = user.transactions || [];
  user.transactions.unshift({date:new Date().toLocaleString(), type:"Shares — "+selectedMachine.code+" ("+lockDays+"d lock)", amount:-price});
  // Raffle: 1 ticket per 35,000 UGX share unit (1 week pack = 1, higher packs scale up)
  var baseUnit = 35000;
  var tixGain = Math.max(1, Math.round(Number(price) / baseUnit));
  user.raffleTickets = (user.raffleTickets || 0) + tixGain;
  user.transactions.unshift({date:new Date().toLocaleString(), type:"Raffle tickets +" + tixGain, amount:0});
  user.transactions.unshift({date:new Date().toLocaleString(), type:"Weekly fund target 5%: "+money(weekly), amount:0});
  if(!user.bonus){
    user.bonus = true;
    if(user.referredBy){
      for(var i=0;i<state.users.length;i++){
        if(state.users[i].id===user.referredBy){
          var rw=Math.round(price*0.05);
          state.users[i].balance=(state.users[i].balance||0)+rw;
          state.users[i].referralEarnings=(state.users[i].referralEarnings||0)+rw;
          state.users[i].referralPayouts=state.users[i].referralPayouts||[];
          state.users[i].referralPayouts.unshift({date:new Date().toLocaleString(), from:user.name, machine:selectedMachine.code, amount:rw});
          break;
        }
      }
    }
  }
  closeModal("buyModal"); save(); render();
  toast("Shares bought · "+lockDays+" days · Daily coupon return");
}


