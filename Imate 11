/* ===== Live currency conversion API ===== */
var CURRENCY_BY_COUNTRY = {
  UG: {code:"UGX", symbol:"UGX"},
  KE: {code:"KES", symbol:"KES"},
  TZ: {code:"TZS", symbol:"TZS"},
  RW: {code:"RWF", symbol:"RWF"},
  NG: {code:"NGN", symbol:"NGN"},
  GH: {code:"GHS", symbol:"GHS"},
  ZA: {code:"ZAR", symbol:"ZAR"},
  EG: {code:"EGP", symbol:"EGP"},
  AE: {code:"AED", symbol:"AED"},
  SA: {code:"SAR", symbol:"SAR"},
  KW: {code:"KWD", symbol:"KWD"},
  GB: {code:"GBP", symbol:"£"},
  US: {code:"USD", symbol:"$"},
  IN: {code:"INR", symbol:"₹"},
  CN: {code:"CNY", symbol:"¥"},
  TR: {code:"TRY", symbol:"₺"},
  EU: {code:"EUR", symbol:"€"},
  FR: {code:"EUR", symbol:"€"},
  DE: {code:"EUR", symbol:"€"},
  IT: {code:"EUR", symbol:"€"},
  ES: {code:"EUR", symbol:"€"}
};
/* Fallback rates: how many local units = 1 USD (used if API offline) */
var FX_FALLBACK_PER_USD = {
  USD:1, UGX:3700, KES:130, TZS:2600, RWF:1300, NGN:1600, GHS:15.5,
  ZAR:18.5, EGP:49, AED:3.67, SAR:3.75, KWD:0.31, GBP:0.79, INR:83, CNY:7.2, TRY:34, EUR:0.92
};
var fxRates = null; // map: currency code -> units per 1 USD
var fxUpdatedAt = 0;
var FX_CACHE_MS = 60 * 60 * 1000; // 1 hour

function userCurrency(user){
  user = user || (typeof currentUser === "function" ? currentUser() : null);
  var cc = (user && (user.country || user.countryCode || "")) || "UG";
  cc = String(cc).toUpperCase();
  return CURRENCY_BY_COUNTRY[cc] || CURRENCY_BY_COUNTRY.UG;
}

function ratePerUSD(code){
  code = String(code || "USD").toUpperCase();
  if(fxRates && fxRates[code] != null) return Number(fxRates[code]);
  return Number(FX_FALLBACK_PER_USD[code] || FX_FALLBACK_PER_USD.UGX || 3700);
}

function toUSD(amountLocal, user){
  var c = userCurrency(user);
  var rate = ratePerUSD(c.code);
  if(!rate) return 0;
  return Math.round((Number(amountLocal||0) / rate) * 100) / 100;
}

function fromUSD(amountUsd, user){
  var c = userCurrency(user);
  var rate = ratePerUSD(c.code);
  return Math.round(Number(amountUsd||0) * rate * 100) / 100;
}

function moneyLocal(amount, user){
  var c = userCurrency(user);
  var n = Number(amount||0);
  return c.symbol + " " + n.toLocaleString(undefined, {maximumFractionDigits: 2});
}

function moneyWithUSD(amount, user){
  var local = moneyLocal(amount, user);
  var usd = toUSD(amount, user);
  return local + " · ≈ $" + usd.toLocaleString(undefined, {maximumFractionDigits: 2});
}

function money(n){
