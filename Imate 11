function submitDeposit(){
  var user = currentUser(); if(!user) return;
  var amount = Number(document.getElementById("depositAmount").value||0);
  var network = document.getElementById("depositNetwork").value;
  var sender = (document.getElementById("depositSender").value||"").trim();
  var ref = (document.getElementById("depositRef").value||"").trim();
  if(amount < 3000){ alert("Minimum UGX 3,000"); return; }
  if(network !== "usdt"){
    var digits = normalizePhone(sender);
    if(!digits || digits.length < 10){ alert("Enter the Mobile Money number you paid from"); return; }
  }
  if(!ref || ref.length < 4){ alert("Paste your Transaction ID after you pay"); return; }
  var method = network==="mtn"?"MTN Mobile Money":network==="airtel"?"Airtel Money":"USDT TRC20";
  user.deposits = user.deposits || [];
  user.deposits.unshift({
    id:"d_"+Date.now(), amount:amount, method:method, network:network,
    channel: network==="usdt"?DEPOSIT_USDT:DEPOSIT_MM,
    sender:sender||"—", reference:ref, status:"pending", date:new Date().toLocaleString()
  });
  user.transactions = user.transactions || [];
  user.transactions.unshift({date:new Date().toLocaleString(), type:"Deposit pending approval — TxID: "+ref, amount:0});
  closeModal("depositFundsModal"); save(); render();
  toast("Deposit submitted.");
}

