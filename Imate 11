.raffle-stage{
  min-height:420px;padding:16px 8px 24px;text-align:center;
  background:radial-gradient(ellipse at 50% 80%, rgba(0,80,160,.35), transparent 60%);
  position:relative;
}
.raffle-grid{
  display:grid;grid-template-columns:repeat(3,1fr);gap:12px;
  max-width:360px;margin:0 auto;padding:10px 0 20px;
}
.raffle-card{
  aspect-ratio:2/3;border-radius:12px;position:relative;
  cursor:pointer;perspective:800px;border:none;background:transparent;
  animation: raffleFloat 3.2s ease-in-out infinite;
}
.raffle-card:nth-child(2){animation-delay:.2s}
.raffle-card:nth-child(3){animation-delay:.4s}
.raffle-card:nth-child(4){animation-delay:.15s}
.raffle-card:nth-child(5){animation-delay:.35s}
.raffle-card:nth-child(6){animation-delay:.55s}
.raffle-card .inner{
  position:absolute;inset:0;border-radius:12px;
  transition:transform .7s ease;transform-style:preserve-3d;
  box-shadow:0 0 18px rgba(0,180,255,.45),0 0 4px rgba(120,80,255,.5);
}
.raffle-card.flipped .inner{transform:rotateY(180deg)}
.raffle-card .face{
  position:absolute;inset:0;border-radius:12px;backface-visibility:hidden;
  border:2px solid rgba(80,200,255,.7);
  overflow:hidden;
}
.raffle-card .back{
  background:
    linear-gradient(145deg, rgba(20,40,120,.9), rgba(5,10,40,.95)),
    repeating-linear-gradient(90deg, transparent, transparent 8px, rgba(0,200,255,.06) 8px, rgba(0,200,255,.06) 9px),
    repeating-linear-gradient(0deg, transparent, transparent 8px, rgba(0,200,255,.06) 8px, rgba(0,200,255,.06) 9px);
  display:flex;align-items:center;justify-content:center;
}
.raffle-card .back img{
  width:78%;height:78%;object-fit:cover;border-radius:50%;
  border:2px solid rgba(100,220,255,.8);
  box-shadow:0 0 16px rgba(0,200,255,.6);
  animation: rafflePulse 2.4s ease-in-out infinite;
}
.raffle-card .front{
  transform:rotateY(180deg);
  background:#061018;
  display:flex;flex-direction:column;align-items:center;justify-content:flex-end;
  padding:8px;text-align:center;
}
.raffle-card .front img{
  position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.9;
}
.raffle-card .front .label{
  position:relative;z-index:2;background:rgba(0,0,0,.65);
  width:100%;padding:6px 4px;border-radius:0 0 10px 10px;
  font-size:10px;color:#9fe8ff;font-weight:700;
}
.raffle-locked{
  padding:28px 16px;text-align:center;color:var(--muted);font-size:13px;line-height:1.5;
}
.raffle-tickets{font-size:12px;color:#7ec8ff;margin:6px 0 12px}
@keyframes raffleFloat{
  0%,100%{transform:translateY(0)}
  50%{transform:translateY(-6px)}
}
@keyframes rafflePulse{
  0%,100%{box-shadow:0 0 10px rgba(0,200,255,.4);transform:scale(1)}
  50%{box-shadow:0 0 22px rgba(0,220,255,.85);transform:scale(1.04)}
}


.user-admin-row{border-bottom:1px solid #12344a;padding:10px 0;font-size:12px}
