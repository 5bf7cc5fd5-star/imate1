/* ===== Moving starfield (behind all tabs) ===== */
(function initSpaceParticles(){
  var canvas = document.getElementById("particleCanvas");
  if(!canvas) return;
  var ctx = canvas.getContext("2d");
  var stars = [];
  var w = 0, h = 0;
  function resize(){
    w = canvas.width = window.innerWidth;
    h = canvas.height = window.innerHeight;
  }
  function spawn(){
    stars = [];
    var n = Math.min(120, Math.floor((w*h)/9000));
    for(var i=0;i<n;i++){
      stars.push({
        x: Math.random()*w - w/2,
        y: Math.random()*h - h/2,
        z: Math.random()*w,
        pz: 0
      });
    }
  }
  function tick(){
    if(!ctx) return;
    ctx.fillStyle = "rgba(2,1,10,0.35)";
    ctx.fillRect(0,0,w,h);
    var cx = w/2, cy = h/2;
    for(var i=0;i<stars.length;i++){
      var s = stars[i];
      s.pz = s.z;
      s.z -= 12;
      if(s.z <= 0){
        s.x = Math.random()*w - w/2;
        s.y = Math.random()*h - h/2;
        s.z = w;
        s.pz = s.z;
      }
      var k = 128 / s.z;
      var px = s.x * k + cx;
      var py = s.y * k + cy;
      var pk = 128 / s.pz;
      var ppx = s.x * pk + cx;
      var ppy = s.y * pk + cy;
      var size = (1 - s.z/w) * 2.2;
      ctx.beginPath();
      ctx.strokeStyle = "rgba(180,220,255," + (0.4 + (1-s.z/w)*0.6) + ")";
      ctx.lineWidth = size;
      ctx.moveTo(ppx, ppy);
      ctx.lineTo(px, py);
      ctx.stroke();
    }
    requestAnimationFrame(tick);
  }
  resize();
  spawn();
  tick();
  window.addEventListener("resize", function(){ resize(); spawn(); });
})();

</script>
