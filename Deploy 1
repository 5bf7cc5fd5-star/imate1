function openModal(id){
  try {
    var m = document.getElementById(id);
    if(!m) return;
    // Full-screen overlay — never show background page
    m.style.display = "flex";
    m.classList.add("open");
    document.body.style.overflow = "hidden";
    // Ensure back header exists
    var sheet = m.querySelector(".sheet");
    if(sheet && !sheet.querySelector(".sheet-top")){
      var top = document.createElement("div");
      top.className = "sheet-top";
      top.innerHTML = '<button type="button" class="back-btn" onclick="closeModal(\''+id+'\')" aria-label="Back">←</button><h3 class="sheet-title"></h3>';
      sheet.insertBefore(top, sheet.firstChild);
    }
    // Hide legacy X
    sheet && sheet.querySelectorAll(".close, .x").forEach(function(b){ b.style.display="none"; });
  } catch(e) { console.warn("openModal", e); }
}
function closeModal(id){
  try {
    var m = document.getElementById(id);
    if(!m) return;
    m.classList.remove("open");
