  const password = prompt('New password (leave blank to keep)', ''); if(password==null) return;
  const title = prompt('Title', u.title||''); if(title==null) return;
  const body = { user_id: uid, name: name.trim(), phone: phone.trim(), email: email.trim(), title: title.trim() };
