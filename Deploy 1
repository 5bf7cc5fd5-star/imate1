function doWithdraw(){
  var _u0=currentUser();
  if(!_u0 || !_u0.machines || !_u0.machines.length){ alert("You must purchase club shares before you can withdraw."); return; }
  if(!slideState.wdSlide){ alert("Slide to verify first"); return; }
  var wdCap = document.getElementById("wdCaptcha");
  if(wdCap && !wdCap.checked){ alert("Tick I'm not a robot"); return; }
  var wdNet = (document.getElementById("withdrawNetwork")||{}).value || "";
  if(!wdNet){ alert("Select network / method"); return; }
  var wdAddr = ((document.getElementById("withdrawAddress")||{}).value || "").trim();
  if(!wdAddr){ alert("Enter wallet address or MoMo number"); return; }

  var user = currentUser(); if(!user) return;
  if(user.withdrawPassword){
    var wp = prompt("Enter your withdraw fund password:");
    if(wp === null) return;
    if(String(wp) !== String(user.withdrawPassword)){ alert("Wrong withdraw password"); return; }
  } else {
    alert("Please set a Withdraw fund password in Settings first.");
    openSettings();
    return;
  }

  var user=currentUser(); if(!user) return;
  var bals=calcBalances(user);
  var amount=Number(document.getElementById("withdrawAmount").value||0);
  if(amount<=0){ alert("Enter amount"); return; }
  var maxWd = typeof withdrawableBalance==="function" ? withdrawableBalance(user) : bals.available;
  if(amount>maxWd){
    if(typeof lockedBonusTotal==="function" && lockedBonusTotal(user)>0){
      alert("Not enough withdrawable balance.\nJoining / deposit bonuses unlock after you buy club shares.\nAvailable: "+money(maxWd));
    } else {
      alert("Not enough available balance.\nShare earnings move to Balance after the 7-day lock completes.");
    }
    return;
  }
  user.withdrawals = user.withdrawals || [];
  var fee=Math.round(amount*0.05*100)/100;
  /* Hold funds: deduct from balance immediately, keep in pending until system approves or rejects */
  user.balance = Math.max(0, Number(user.balance||0) - amount);
  var sysTx = "WD" + Date.now().toString(36).toUpperCase() + Math.random().toString(36).slice(2,8).toUpperCase();
  user.withdrawals.unshift({
    id:"w_"+Date.now(), amount:amount, fee:fee, net:amount-fee,
    status:"under_review",
    txid: sysTx,
    system_txid: sysTx,
    balanceHeld: true,
    network: wdNet,
    address: wdAddr,
    date:new Date().toLocaleString(),
    status_history: [{status:"under_review", at:new Date().toLocaleString(), note:"Submitted"}]
  });
  user.pendingWithdraw = (user.pendingWithdraw||0) + amount;
  user.transactions = user.transactions || [];
  user.transactions.unshift({date:new Date().toLocaleString(), type:"Withdrawal on hold (pending approval)", amount:-amount});
  // Company pool: hold equivalent USD until approve (deduct) or reject (return)
  try {
    var holdUsd = amountLocalToUSD(amount, user);
    adjustRewardPool(-holdUsd, "Withdrawal hold → "+(user.name||user.phone||""), {userId:user.id, type:"withdraw_hold"});
  } catch(eH){}
  closeModal("withdrawModal"); save();
  try{ updateRewardPoolDisplay(); }catch(e){}
  toast("Withdrawal submitted — funds on hold until system confirms.");
}


