/**
 * Build multilevel team under `user`.
 * Returns { list: [{user, level}, ...], byLevel: {1:[...], 2:[...]} }
 */
function getTeamRecursive(user, maxLevel){
  maxLevel = maxLevel || 20;
  var result = { list: [], byLevel: {} };
  if(!user) return result;
  var seen = {};
  seen[user.id] = 1;
  var queue = [{ uid: user.id, level: 0 }];
  // BFS by levels
  var levelMap = {}; // level -> array of user objects
  levelMap[0] = [user];
  for(var lvl=0; lvl<maxLevel; lvl++){
    var parents = levelMap[lvl] || [];
    if(!parents.length) break;
    levelMap[lvl+1] = [];
    for(var p=0; p<parents.length; p++){
      var kids = getDirectReferrals(parents[p]);
      for(var k=0; k<kids.length; k++){
        var child = kids[k];
        if(!child || seen[child.id]) continue;
        seen[child.id] = 1;
        levelMap[lvl+1].push(child);
        result.list.push({ user: child, level: lvl+1 });
      }
    }
  }
  for(var L=1; L<=maxLevel; L++){
    if(levelMap[L] && levelMap[L].length) result.byLevel[L] = levelMap[L];
  }
  return result;
}

