  // Server login first — no extra popup
  if(typeof apiCall === "function"){
    apiCall("/api/login", "POST", { email: id, phone: id, password: pass }).then(function(res){
      if(res && res.token){
        try { localStorage.setItem("imate1_token", res.token); } catch(e){}
      }
      if(res && res.user){
        try {
          if(typeof mergeServerUser==="function") mergeServerUser(res.user);
          else {
            var found = null;
            state.users = state.users || [];
            for(var i=0;i<state.users.length;i++){
              if(state.users[i].email && String(state.users[i].email).toLowerCase()===String(res.user.email||"").toLowerCase()){
                found = state.users[i]; break;
              }
            }
            if(!found){
              found = { id: res.user.id, email: res.user.email, phone: res.user.phone, name: res.user.name, balance: res.user.balance||0, machines:[], transactions:[], deposits:[], withdrawals:[] };
              state.users.push(found);
            }
            found.serverId = res.user.id;
            found.isAdmin = !!(res.user.is_admin);
            found.isSupport = !!(res.user.is_support);
            found.isStaff = !!(res.user.is_staff);
            found.inviteCode = res.user.invite_code || found.inviteCode;
            finishLocal(found);
            try { if(typeof syncMeFromServer==="function") syncMeFromServer(); } catch(e){}
            try { if(typeof syncTeamFromServer==="function") syncTeamFromServer(); } catch(e){}
            return;
          }
        } catch(e){ console.warn(e); }
      }
      if(res && res.user){
        var u2 = null;
        for(var j=0;j<(state.users||[]).length;j++){
          if(state.users[j].id===res.user.id || (state.users[j].email||"").toLowerCase()===(res.user.email||"").toLowerCase()){
            u2 = state.users[j]; break;
          }
        }
        if(u2) finishLocal(u2);
      }
    }).catch(function(){
      // local fallback
      var needle = id.toLowerCase().replace(/\s+/g,"");
      var users = (state && state.users) || [];
      for(var i=0;i<users.length;i++){
        var u = users[i];
        if(!u) continue;
        var em = String(u.email||"").toLowerCase();
