/* ===== LIVE SPACE WALLPAPER (always behind all pages) ===== */
html, body {
  margin: 0;
  min-height: 100%;
  background: #000 !important;
}
.space-bg {
  position: fixed !important;
  inset: 0 !important;
  z-index: 0 !important;
  pointer-events: none !important;
  overflow: hidden !important;
  background: #02010a !important;
}
.space-bg .warp-img {
  position: absolute;
  inset: -25%;
  background: linear-gradient(180deg, #0a3d1f 0%, #14532d 40%, #052e16 100%);
  animation: spaceZoom 18s linear infinite;
  opacity: 0.85;
  filter: saturate(1.3) brightness(0.85) contrast(1.1);
}
.space-bg .warp-stars {
  position: absolute;
  inset: -40%;
  background-image:
    radial-gradient(1.5px 1.5px at 8% 12%, #fff, transparent),
    radial-gradient(1px 1px at 22% 48%, #a8d8ff, transparent),
    radial-gradient(2px 2px at 38% 22%, #fff, transparent),
    radial-gradient(1px 1px at 55% 70%, #cde, transparent),
    radial-gradient(1.5px 1.5px at 70% 35%, #fff, transparent),
    radial-gradient(1px 1px at 85% 60%, #9cf, transparent),
    radial-gradient(2px 2px at 12% 80%, #fff, transparent),
    radial-gradient(1px 1px at 48% 8%, #def, transparent),
    radial-gradient(1px 1px at 92% 18%, #fff, transparent),
    radial-gradient(1.5px 1.5px at 65% 88%, #bdf, transparent),
    radial-gradient(1px 1px at 30% 92%, #fff, transparent),
    radial-gradient(1px 1px at 78% 78%, #ace, transparent);
  background-size: 100% 100%;
  animation: spaceStreak 10s linear infinite;
  opacity: 0.9;
}
#particleCanvas {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  display: block;
  opacity: 0.7;
}
.space-vignette {
  position: absolute;
  inset: 0;
  background:
    radial-gradient(ellipse at center, transparent 20%, rgba(0,0,15,0.55) 100%),
    linear-gradient(180deg, rgba(10,20,60,0.20), transparent 40%, rgba(0,0,20,0.4));
  animation: spacePulse 7s ease-in-out infinite alternate;
}
@keyframes spaceZoom {
  0%   { transform: scale(1) translate(0,0); }
  50%  { transform: scale(1.25) translate(-2%, 1%); }
  100% { transform: scale(1.45) translate(0,0); }
}
@keyframes spaceStreak {
  0%   { transform: scale(1) rotate(0deg); opacity: 0.6; }
  100% { transform: scale(1.8) rotate(2deg); opacity: 1; }
}
@keyframes spacePulse {
  0%   { opacity: 0.7; }
  100% { opacity: 1; }
}

