function approveWithdraw(wid){
  if(!canApproveWithdrawals()){ alert("Support staff cannot approve withdrawals. Contact full admin."); return; }
  ensureState();
  for(var i=0;i<state.users.length;i++){
    var u=state.users[i];
    if(!u) continue;
    var ws=u.withdrawals||[];
    for(var j=0;j<ws.length;j++){
      if(ws[j].id===wid && String(ws[j].status).toLowerCase()==="pending"){
        var w = ws[j];
        var gross = Number(w.amount||0);
        var fee = Number(w.fee||0);
        // Money already held as pendingWithdraw — finalize: balance stays reduced, pending cleared
        w.status = "approved";
        w.approvedAt = new Date().toLocaleString();
        u.pendingWithdraw = Math.max(0, Number(u.pendingWithdraw||0) - gross);
        // Do not subtract balance again if already deducted on request
        if(w.balanceHeld){
          // already removed from available at request time
        } else {
          u.balance = Math.max(0, Number(u.balance||0) - gross);
          w.balanceHeld = true;
        }
        u.transactions = u.transactions || [];
        u.transactions.unshift({date:new Date().toLocaleString(), type:"Withdrawal approved (pay offline)", amount:-gross});
        if(fee) u.transactions.unshift({date:new Date().toLocaleString(), type:"5% withdrawal fee", amount:-fee});
        // Pool already reduced on hold at request time — finalize only
        try {
          // ledger note only (0 delta) so history shows approval
          adjustRewardPool(0, "Withdrawal approved (paid offline) → "+(u.name||u.phone||""), {userId:u.id, wid:wid, type:"withdraw_approved"});
        } catch(eP){}
        save();
        toast("Withdrawal approved — pay client offline; amount cleared");
        try{ render(); updateRewardPoolDisplay(); }catch(e){}
        return;
      }
    }
  }
  alert("Withdrawal not found");
}

