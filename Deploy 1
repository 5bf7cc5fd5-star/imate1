/* ===== Biometric login (WebAuthn / Face ID / Touch ID / fingerprint) ===== */
function b64url(buf){
  var b = btoa(String.fromCharCode.apply(null, new Uint8Array(buf)));
  return b.replace(/\+/g,"-").replace(/\//g,"_").replace(/=+$/,"");
}
function b64urlToBuf(s){
  s = String(s||"").replace(/-/g,"+").replace(/_/g,"/");
  while(s.length % 4) s += "=";
  var bin = atob(s);
  var out = new Uint8Array(bin.length);
  for(var i=0;i<bin.length;i++) out[i] = bin.charCodeAt(i);
  return out.buffer;
}
function biometricAvailable(){
  return !!(window.PublicKeyCredential && navigator.credentials && navigator.credentials.create);
}
async function enableBiometric(){
  if(!biometricAvailable()){
    if(typeof toast==="function") toast("This device does not support Face ID / fingerprint login");
    return;
  }
  var user = (typeof currentUser==="function") ? currentUser() : null;
  if(!user){
    if(typeof toast==="function") toast("Log in first, then enable biometric");
    return;
  }
  try {
    var challenge = new Uint8Array(32);
    (window.crypto||crypto).getRandomValues(challenge);
    var uid = new TextEncoder().encode(String(user.id||user.email||"user"));
    var cred = await navigator.credentials.create({
      publicKey: {
        challenge: challenge,
        rp: { name: "Own Club", id: location.hostname },
        user: { id: uid, name: user.email || user.phone || "member", displayName: user.name || "Member" },
        pubKeyCredParams: [{type:"public-key", alg:-7},{type:"public-key", alg:-257}],
        authenticatorSelection: {
          authenticatorAttachment: "platform",
          residentKey: "preferred",
          requireResidentKey: false,
          userVerification: "required"
        },
        timeout: 60000,
        attestation: "none"
      }
    });
    if(!cred) throw new Error("cancelled");
    var cid = b64url(cred.rawId);
    try { localStorage.setItem("imate1_bio_id", cid); } catch(e){}
    if(typeof apiCall === "function"){
      await apiCall("/api/webauthn/register", "POST", { credential_id: cid, device: (navigator.userAgent||"Device").slice(0,70) });
    }
    if(typeof toast==="function") toast("Face ID / fingerprint enabled");
  } catch(e){
    console.warn("bio enable", e);
    if(typeof toast==="function") toast("Could not enable biometric");
  }
}
async function biometricLogin(){
  if(!biometricAvailable()){
    if(typeof toast==="function") toast("Use email and password on this device");
    return;
  }
  try {
    var challenge = new Uint8Array(32);
    (window.crypto||crypto).getRandomValues(challenge);
    var allow = [];
    try {
      var saved = localStorage.getItem("imate1_bio_id");
      if(saved) allow.push({ type:"public-key", id: b64urlToBuf(saved) });
    } catch(e){}
    var pk = {
      challenge: challenge,
      rpId: location.hostname,
      userVerification: "required",
      timeout: 60000
    };
    // If this device has a local id, prefer it; otherwise use discoverable/synced passkeys
    if(allow.length) pk.allowCredentials = allow;
    var assert = await navigator.credentials.get({ publicKey: pk });
    if(!assert) throw new Error("cancelled");
    var cid = b64url(assert.rawId);
    if(typeof apiCall === "function"){
      var res = await apiCall("/api/webauthn/login", "POST", { credential_id: cid });
      if(res && res.token){
        try { localStorage.setItem("imate1_token", res.token); } catch(e){}
      }
      if(res && res.user && typeof doLogin === "function"){
        // reuse password-less enter by setting fields and calling finish
        try {
          var idEl = document.getElementById("loginId");
