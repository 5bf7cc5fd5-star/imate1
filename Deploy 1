      var card = document.getElementById("adminPanelCard");
      if(card){
        if(staff) card.classList.remove("hidden");
        else { card.classList.add("hidden"); card.style.display = "none"; }
      }
      var badge = document.getElementById("adminBadgeHdr");
      if(badge && !staff) badge.classList.add("hidden");
    } catch(e){}
    return r;
  };
}

// Hide system dashboard for members after render
setInterval(function(){
  try {
    if(!isStaffUser()){
      var card = document.getElementById("adminPanelCard");
      if(card){ card.classList.add("hidden"); card.style.display="none"; }
    }
  } catch(e){}
}, 1500);


/* Reliable back navigation */
window.goBack = function(){
  try {
    var open = document.querySelector(".modal.open");
    if(open && open.id){
      if(typeof closeModal === "function") closeModal(open.id);
      else { open.classList.remove("open"); open.style.display = "none"; document.body.style.overflow = ""; }
      return false;
    }
    var active = document.querySelector(".page.active");
    if(active && active.id && active.id !== "home" && typeof goPage === "function"){
      goPage("home"); return false;
    }
    if(typeof goPage === "function") goPage("home");
  } catch(e){ console.warn("goBack", e); }
  return false;
};
document.addEventListener("click", function(ev){
  var b = ev.target && ev.target.closest && ev.target.closest(".back-btn");
  if(!b) return;
  ev.preventDefault();
  ev.stopPropagation();
  var dest = b.getAttribute("data-back");
  if(dest && typeof goPage === "function"){ goPage(dest); return; }
  if(typeof window.goBack === "function") window.goBack();
}, true);
window.doLogin = typeof doLogin === "function" ? doLogin : window.doLogin;
}
