async function loadAll(){
  try{
    const tasks = [
      api('/api/admin/stats').catch(()=>({})),
      api('/api/admin/withdrawals').catch(()=>({withdrawals:[]})),
      api('/api/admin/users').catch(()=>({users:[]})),
      api('/api/admin/deposits').catch(()=>({deposits:[]})),
      api('/api/admin/referral-dashboard').catch(()=>api('/api/admin/referrals').catch(()=>({})))
    ];
    const [stats, wds, users, deps, refs] = await Promise.all(tasks);
    try{ if(refs && refs.levels) renderReferralDashboard(refs); else renderReferrals((refs&&refs.referrals)||[]); }catch(e){}
    console.log('loadAll users', (users && users.users && users.users.length) || 0);
    cache.stats = stats;
    cache.withdrawals = wds.withdrawals || wds || [];
    cache.users = users.users || users || [];
    cache.deposits = deps.deposits || deps || [];

    const set = (id, v) => { const el=document.getElementById(id); if(el) el.textContent=v; };
    set('mUsers', stats.total_users ?? cache.users.length ?? 0);
    set('sUsers', stats.total_users ?? cache.users.length ?? 0);
    set('mInvested', money(stats.total_invested||0));
    set('sInvested', money(stats.total_invested||0));
