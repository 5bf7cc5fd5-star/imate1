        apiCall("/api/admin/deposits").catch(function(){ return { deposits: [] }; }),
        apiCall("/api/admin/withdrawals").catch(function(){ return { withdrawals: [] }; }),
        apiCall("/api/admin/users").catch(function(){ return { users: [] }; }),
        apiCall("/api/admin/stats").catch(function(){ return {}; })
