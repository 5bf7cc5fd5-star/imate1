function getRewardPoolUSD(){
  // Server is source of truth when synced
  if(state && state.serverPoolUSD != null && !isNaN(Number(state.serverPoolUSD))){
    return Math.round(Number(state.serverPoolUSD) * 100) / 100;
  }
  var admin = ensureRewardPool();
  return admin ? Math.round(Number(admin.rewardPool||0) * 100) / 100 : REWARD_POOL_START_USD;
}

/** usdDelta: positive = add to pool, negative = deduct from pool (local cache only; server is master) */
function adjustRewardPool(usdDelta, reason, meta){
  var admin = ensureRewardPool();
  if(!admin) return false;
  var d = Math.round(Number(usdDelta||0) * 100) / 100;
  admin.rewardPool = Math.round((Number(admin.rewardPool||0) + d) * 100) / 100;
  if(state.serverPoolUSD != null){
    state.serverPoolUSD = Math.round((Number(state.serverPoolUSD) + d) * 100) / 100;
  }
  admin.poolLedger = admin.poolLedger || [];
  admin.poolLedger.unshift({
    date: new Date().toLocaleString(),
    iso: new Date().toISOString(),
    delta: d,
    balance: admin.rewardPool,
    reason: reason || "",
    meta: meta || null
  });
  if(admin.poolLedger.length > 800) admin.poolLedger = admin.poolLedger.slice(0, 800);
  try { updateRewardPoolDisplay(); try{renderAccountLedger(currentUser());}catch(e){} } catch(e){}
  return true;
}

