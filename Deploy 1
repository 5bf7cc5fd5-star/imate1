function startSlide(e, id){
  e.preventDefault();
  var box = document.getElementById(id);
  var knob = document.getElementById(id === "depSlide" ? "depSlideKnob" : "wdSlideKnob");
  var lab = document.getElementById(id === "depSlide" ? "depSlideLabel" : "wdSlideLabel");
  if(!box || !knob) return;
  var rect = box.getBoundingClientRect();
  var max = rect.width - knob.offsetWidth - 8;
  function move(ev){
    var x = (ev.touches ? ev.touches[0].clientX : ev.clientX) - rect.left - 22;
    if(x < 0) x = 0;
    if(x > max) x = max;
    knob.style.marginLeft = x + "px";
    if(x >= max * 0.92){
      slideState[id] = true;
      knob.style.marginLeft = max + "px";
      if(lab) lab.textContent = "Verified ✓";
      box.classList.add("done");
      end();
    }
  }
  function end(){
    window.removeEventListener("pointermove", move);
    window.removeEventListener("pointerup", end);
    window.removeEventListener("touchmove", move);
    window.removeEventListener("touchend", end);
  }
  window.addEventListener("pointermove", move);
  window.addEventListener("pointerup", end);
  window.addEventListener("touchmove", move, {passive:false});
  window.addEventListener("touchend", end);
}

