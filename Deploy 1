        }
        if(ru.deposits && ru.deposits.length){
          found.deposits = mergeById(found.deposits || [], ru.deposits);
        }
      }

      // Attach deposits from admin list
      for(var d=0; d<deps.length; d++){
        var dep = deps[d];
        if(!dep) continue;
        var uid = dep.user_id || dep.userId;
        var u = null;
        for(var k=0;k<state.users.length;k++){
          if(String(state.users[k].id)===String(uid)){ u = state.users[k]; break; }
        }
        if(!u){
          u = {
            id: uid || ("u_"+Date.now()+"_"+d),
            name: dep.user_name || "Member",
            phone: dep.user_phone || "",
            email: dep.user_email || "",
            balance: 0,
            deposits: [],
            withdrawals: [],
            transactions: [],
            machines: []
          };
          state.users.push(u);
        }
        u.deposits = u.deposits || [];
        var exists = false;
        for(var x=0;x<u.deposits.length;x++){
          if(String(u.deposits[x].id)===String(dep.id)){
            // update status
            u.deposits[x].status = dep.status || u.deposits[x].status;
            u.deposits[x].reference = dep.reference || dep.txId || u.deposits[x].reference;
            u.deposits[x].amount = dep.amount != null ? dep.amount : u.deposits[x].amount;
            exists = true; break;
          }
