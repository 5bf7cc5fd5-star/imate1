    // simple activity series from counts
    const base = Number(stats.total_invested||0) / 10000;
    const pts = Array.from({length:24}, (_,i)=> Math.max(2, base*0.2 + Math.sin(i/2)*8 + i*1.2 + (i%3)*3));
