function flipRaffleCard(id){
  var user = currentUser(); if(!user) return;
  if(!user.machines || !user.machines.length){
    toast("Buy club shares first to unlock raffles");
    return;
  }
  var el = document.getElementById("rcard"+id);
  if(!el) return;
  if(el.classList.contains("flipped")) return;
  if(userRaffleTickets(user) <= 0){
    toast("No raffle tickets left — deposit and buy another share to get new tickets");
    return;
  }
  el.classList.add("flipped");
  user.raffleTickets = userRaffleTickets(user) - 1;
  var card = null;
  for(var i=0;i<raffleCards.length;i++) if(raffleCards[i].id===id){ card=raffleCards[i]; break; }
  // Not always a win — ~35% chance of cash prize
  var win = Math.random() < 0.35;
  var prize = 0;
  if(win && card){
    var base = Number(card.prize||card.price||0);
    if(base <= 0) base = [500,1000,2000,5000,10000][Math.floor(Math.random()*5)];
    prize = base;
  }
  user.raffleEntries = user.raffleEntries || [];
  user.raffleEntries.unshift({
    id: "rf_"+Date.now(),
    raffleId: id,
    name: card ? card.name : ("R"+id),
    theme: card ? card.theme : "",
    price: prize,
    date: new Date().toLocaleString(),
    status: prize>0 ? "won" : "miss"
  });
  user.transactions = user.transactions || [];
  user.transactions.unshift({
    date: new Date().toLocaleString(),
    type: prize>0 ? ("Raffle win — "+(card?card.theme:id)) : ("Raffle miss — "+(card?card.theme:id)),
    amount: prize
  });
  if(prize > 0){
    user.balance = Number(user.balance||0) + prize;
    try {
      var prizeUsd = amountLocalToUSD(prize, user);
      adjustRewardPool(-prizeUsd, "Raffle prize → "+(user.name||user.phone||""), {userId:user.id, raffleId:id, type:"raffle"});
    } catch(eR){}
  }
  save();
  // Show result then reshuffle after short delay
  toast(prize > 0 ? ("You won "+money(prize)+"!") : "No prize this time — buy another share for more tickets");
  var sec = document.getElementById("raffleSecondChance");
  if(!sec){
    var stage = document.getElementById("raffleStage") || document.getElementById("raffleList");
    if(stage){
      sec = document.createElement("div");
      sec.id = "raffleSecondChance";
      sec.style.cssText = "margin:10px 0;text-align:center";
      stage.parentNode.insertBefore(sec, stage.nextSibling);
    }
  }
  if(sec){ sec.innerHTML = ""; }
  setTimeout(function(){ try{ renderRaffle(); render(); updateRewardPoolDisplay(); }catch(e){} }, 1600);
}

