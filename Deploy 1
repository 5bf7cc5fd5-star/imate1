function authorizeCoManager(userId){
  var me = currentUser();
  if(!me || !me.isAdmin){ toast("Only system owner can authorize co-managers"); return; }
  ensureState();
  for(var i=0;i<state.users.length;i++){
    if(state.users[i].id===userId){
      if(state.users[i].isAdmin){ toast("Cannot change system owner"); return; }
      state.users[i].isCoManager = true;
