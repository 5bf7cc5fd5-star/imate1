          if((lu.id && ru.id && String(lu.id)===String(ru.id)) ||
             (lu.email && ru.email && String(lu.email).toLowerCase()===String(ru.email).toLowerCase()) ||
             (lu.phone && ru.phone && String(lu.phone)===String(ru.phone))){
