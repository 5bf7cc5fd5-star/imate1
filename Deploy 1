/* ===== Automated customer onboarding ===== */
function getOnboardProgress(user){
  user = user || currentUser();
  if(!user) return {step:0, done:[]};
  var done = [];
  if(user.id) done.push("account");
  if(user.welcomeCredited || Number(user.balance||0) > 0) done.push("welcome");
  var deps = user.deposits || [];
  var hasConfirmedDep = deps.some(function(d){ return d && String(d.status||"").toLowerCase()==="confirmed"; });
  var hasPendingDep = deps.some(function(d){ return d && String(d.status||"").toLowerCase()==="pending"; });
  if(hasConfirmedDep) done.push("deposit");
  else if(hasPendingDep) done.push("deposit_pending");
  var machines = user.machines || user.shares || [];
  if(machines.length) done.push("shares");
  if(user.inviteCode) done.push("invite");
  // next incomplete step
  var order = ["account","welcome","deposit","shares","invite"];
  var step = "done";
  for(var i=0;i<order.length;i++){
    if(done.indexOf(order[i]) < 0 && !(order[i]==="deposit" && done.indexOf("deposit_pending")>=0)){
      if(order[i]==="deposit" && done.indexOf("deposit_pending")>=0) continue;
      step = order[i];
      break;
    }
  }
  if(done.indexOf("deposit_pending")>=0 && done.indexOf("deposit")<0) step = "deposit";
  if(done.indexOf("account")>=0 && done.indexOf("welcome")>=0 && done.indexOf("deposit")>=0 && done.indexOf("shares")>=0) step = "done";
  return {step: step, done: done};
}

