function mergeById(localArr, remoteArr){
  localArr = localArr || [];
  remoteArr = remoteArr || [];
  var map = {};
  for(var i=0;i<localArr.length;i++) if(localArr[i] && localArr[i].id) map[String(localArr[i].id)] = localArr[i];
  for(var j=0;j<remoteArr.length;j++){
    var r = remoteArr[j];
    if(!r || !r.id) continue;
    var id = String(r.id);
    if(map[id]){
      map[id].status = r.status || map[id].status;
      if(r.amount != null) map[id].amount = r.amount;
      if(r.reference) map[id].reference = r.reference;
    } else {
      map[id] = r;
    }
  }
  var out = [];
  for(var k in map) if(map.hasOwnProperty(k)) out.push(map[k]);
  out.sort(function(a,b){ return String(b.date||b.created_at||"").localeCompare(String(a.date||a.created_at||"")); });
  return out;
}

