      } catch(ePool){}

      // Merge remote users lightly into state by email/phone/id
      for(var i=0;i<remoteUsers.length;i++){
        var ru = remoteUsers[i];
        if(!ru) continue;
        var found = null;
        for(var j=0;j<state.users.length;j++){
          var lu = state.users[j];
