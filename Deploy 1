function sparklineSvg(history, up){
  var h = history || [1,1,1,1];
  var min = Math.min.apply(null, h), max = Math.max.apply(null, h);
  var span = (max - min) || 1;
  var w = 72, ht = 28, pts = [];
  for(var i=0;i<h.length;i++){
    var x = (i/(h.length-1||1)) * (w-2) + 1;
    var y = ht - 2 - ((h[i]-min)/span)*(ht-4);
    pts.push(x.toFixed(1)+","+y.toFixed(1));
  }
  var color = up ? "#20e58b" : "#ff5c7a";
  return '<svg class="market-spark" viewBox="0 0 '+w+' '+ht+'" xmlns="http://www.w3.org/2000/svg"><polyline fill="none" stroke="'+color+'" stroke-width="1.8" points="'+pts.join(" ")+'"/></svg>';
}
function renderClubMarket(){
  loadClubMarket();
  var el = document.getElementById("clubMarketList");
  if(!el) return;
  var rows = [];
  var gainers = 0, losers = 0;
  for(var i=0;i<machines.length;i++){
    var m = machines[i];
    if(!m) continue;
    if(leagueFilter && leagueFilter !== "all" && m.league !== leagueFilter) continue;
    var p = (clubMarketState.prices && clubMarketState.prices[String(m.id)]) || { price: baseMarketPrice(m), change: 0, history: [0,0,0] };
    var ch = Number(p.change||0);
    if(ch >= 0) gainers++; else losers++;
    rows.push({ m: m, p: p, ch: ch });
  }
  rows.sort(function(a,b){ return Math.abs(b.ch) - Math.abs(a.ch); });
  var gEl = document.getElementById("mktGainers");
  var lEl = document.getElementById("mktLosers");
  if(gEl) gEl.textContent = String(gainers);
  if(lEl) lEl.textContent = String(losers);
  if(!rows.length){ el.innerHTML = '<div class="empty">No clubs in this league</div>'; return; }
  var h = "";
  for(var r=0;r<rows.length;r++){
    var item = rows[r];
    var m = item.m;
    var up = item.ch >= 0;
    var chStr = (up?"+":"")+item.ch.toFixed(2)+"%";
    var photo = m.photo || m.photoFb || "";
    h += '<div class="market-row" onclick="openBuy('+(m.id)+')">'+
      '<img src="'+photo+'" alt="" onerror="this.src=\''+(m.photoFb||'')+'\'">'+
      '<div><div class="mname">'+escHtml(m.code||m.name)+'</div>'+
      '<div class="mleague">'+escHtml(m.league||"")+' · '+escHtml(m.marketValue||"")+'</div>'+
      sparklineSvg(item.p.history, up)+
      '</div>'+
      '<div><div class="mprice">'+Number(item.p.price||0).toLocaleString()+'</div>'+
      '<div class="mchg '+(up?"up":"down")+'">'+chStr+'</div></div>'+
    '</div>';
  }
  el.innerHTML = h;
}


