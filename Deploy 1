/* ===== WebSocket real-time sync ===== */
var IMATE1_WS = null;
var IMATE1_WS_RETRY = 0;

function imate1WsUrl(){
  try {
    var proto = location.protocol === "https:" ? "wss:" : "ws:";
    var tok = "";
    try { tok = localStorage.getItem("imate1_token") || (typeof API_TOKEN!=="undefined"?API_TOKEN:"") || ""; } catch(e){}
    return proto + "//" + location.host + "/ws" + (tok ? ("?token=" + encodeURIComponent(tok)) : "");
  } catch(e) {
    return null;
  }
}

function connectRealtime(){
  try {
    if(IMATE1_WS && (IMATE1_WS.readyState===0 || IMATE1_WS.readyState===1)) return;
    var url = imate1WsUrl();
    if(!url || typeof WebSocket === "undefined") return;
    var ws = new WebSocket(url);
    IMATE1_WS = ws;
    ws.onopen = function(){
      IMATE1_WS_RETRY = 0;
      try {
        var tok = localStorage.getItem("imate1_token") || API_TOKEN;
        if(tok) ws.send(JSON.stringify({type:"auth", token: tok}));
      } catch(e){}
      console.log("[ws] connected");
    };
    ws.onmessage = function(ev){
      try {
        var msg = JSON.parse(ev.data);
        var evn = msg.event || msg.type;
        if(evn === "pong" || evn === "connected" || evn === "authed") return;
        if(["balance","deposit","user_joined","users","team","pool","referral","withdraw","purchase","notification"].indexOf(evn) >= 0){
          try { if(typeof syncMeFromServer==="function") syncMeFromServer(); } catch(e){}
