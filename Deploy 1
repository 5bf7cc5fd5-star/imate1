          try { if(typeof renderTeamTree==="function") renderTeamTree(typeof currentUser==="function"?currentUser():null); } catch(e){}
        }
      } catch(e){}
    };
    ws.onclose = function(){
      IMATE1_WS = null;
      var wait = Math.min(15000, 1000 * Math.pow(1.5, IMATE1_WS_RETRY++));
      setTimeout(connectRealtime, wait);
    };
    ws.onerror = function(){ try{ ws.close(); }catch(e){} };
  } catch(e) { console.warn("[ws]", e); }
}
