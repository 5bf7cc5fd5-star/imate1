function adminApproveDeposit(userId, depId){
  var me = currentUser();
  if(!me || !(me.isAdmin || me.isCoManager || me.canManualCredit)){ alert("System authorization required"); return; }
  ensureState();
  for(var i=0;i<state.users.length;i++){
    var u = state.users[i];
    if(!u || u.id !== userId) continue;
    var deps = u.deposits || [];
    for(var j=0;j<deps.length;j++){
      if(deps[j].id === depId){
        var d = deps[j];
        if(String(d.status).toLowerCase() === "confirmed" || String(d.status).toLowerCase() === "approved"){
          toast("Already approved"); return;
        }
        if(!d.txidAdminVerified){
          var txc = d.reference || d.txId || "";
          if(!window.confirm("TxID not marked verified yet.\n\nTxID: "+txc+"\n\nVerify and approve in one step?")) return;
          d.txidAdminVerified = true;
          d.txidVerifiedAt = new Date().toLocaleString();
          d.txidVerifiedBy = me.email || "admin";
        }
        d.status = "confirmed";
        d.approvedAt = new Date().toLocaleString();
        d.approvedBy = me.email || "admin";
        var depAmt = Number(d.amount||0);
        var depBonus = 0;
        var joinExtra = 0;
        if(Math.round(depAmt) === 3000 && !u.join3000BonusCredited){
          joinExtra = 1500;
          u.join3000BonusCredited = true;
          u.welcomeCredited = true;
          u.joinRewardUgx = 1500;
        } else if(Math.round(depAmt) !== 3000){
          depBonus = Math.round(depAmt * 0.025);
        }
        var creditTotal = depAmt + depBonus + joinExtra;
        d.bonus25 = depBonus; d.bonus5 = depBonus;
        d.creditedTotal = creditTotal;
        u.balance = Number(u.balance||0) + creditTotal;
        u.depositBonusTotal = Number(u.depositBonusTotal||0) + depBonus;
        if(joinExtra){
          u.transactions = u.transactions || [];
          u.transactions.unshift({date:new Date().toLocaleString(), type:"Joining bonus UGX 1,500 (3,000 deposit)", amount:joinExtra});
        }
        if(!(u.machines||[]).length) u.depositBonusLocked = true;
        // Fund pool: deduct deposit credit + 2.5% bonus from company pool when approving
        try {
          var depUsd = amountLocalToUSD(depAmt, u);
          var bonusUsd = amountLocalToUSD(depBonus, u);
          adjustRewardPool(-(depUsd + bonusUsd), "Deposit approved → wallet "+(u.name||u.phone||userId), {userId:u.id, depId:depId, type:"deposit_credit"});
        } catch(ePool) {}
        u.transactions = u.transactions || [];
        u.transactions.unshift({
          date: new Date().toLocaleString(),
          type: "Deposit approved — "+(d.method||"MoMo/USDT"),
          amount: depAmt
        });
        u.transactions.unshift({
          date: new Date().toLocaleString(),
          type: "Deposit 2.2.5% bonus",
          amount: depBonus
        });
        u.rewards = u.rewards || [];
        u.rewards.unshift({
          id: "rw_dep_"+Date.now(),
          type: "deposit_bonus",
          title: "Deposit 2.2.5% bonus",
          detail: "Bonus on "+money(depAmt),
          amount: depBonus,
          date: new Date().toLocaleString()
        });
        try{ creditReferrerDividend(u, depAmt); }catch(e){}
        // clear global queue entry
        state.pendingDeposits = (state.pendingDeposits||[]).filter(function(x){ return x && x.depId !== depId; });
        save();
        toast("Approved "+money(depAmt)+" + 5% "+money(depBonus)+" → "+money(creditTotal));
        try{
          pushStaffNotification(
            "Deposit APPROVED",
            (u.name||"Member")+" · "+money(d.amount)+" · TxID "+(d.reference||d.txId||""),
            { type:"deposit_approved", depId: depId, userId: userId }
          );
        }catch(e){}
        renderAdminPendingDeposits();
        try{ render(); }catch(e){}
        return;
      }
    }
  }
  alert("Deposit not found. Member may have used a different device (local data only).");
}

