/* ===== CLUB STOCK MARKET (daily track) ===== */
var marketViewMode = "shares"; // shares | market
var clubMarketState = null; // { dayKey, prices: {id: {price, change, history:[]}} }

function marketDayKey(){
  var d = new Date();
  return d.getFullYear()+"-"+String(d.getMonth()+1).padStart(2,"0")+"-"+String(d.getDate()).padStart(2,"0");
}
function seededRand(seed){
  var x = Math.sin(seed) * 10000;
  return x - Math.floor(x);
}
function baseMarketPrice(m){
  // Derive from nominal club value string or id
  var mv = String(m.marketValue||"");
  var num = parseFloat(mv.replace(/[^0-9.]/g,"")) || (3 + (m.id%7));
  // map billions to UGX-ish display index around 30k-80k
  return Math.round((28000 + num * 4200 + (m.id * 317) % 9000) / 100) * 100;
}
function loadClubMarket(){
  try {
    var raw = localStorage.getItem("imate1_club_market");
    if(raw) clubMarketState = JSON.parse(raw);
  } catch(e){ clubMarketState = null; }
  if(!clubMarketState || !clubMarketState.prices) clubMarketState = { dayKey: "", prices: {} };
  ensureClubMarketDay();
}
function saveClubMarket(){
  try { localStorage.setItem("imate1_club_market", JSON.stringify(clubMarketState)); } catch(e){}
}
function ensureClubMarketDay(){
  var key = marketDayKey();
  var needNew = clubMarketState.dayKey !== key;
  if(!clubMarketState.prices) clubMarketState.prices = {};
  for(var i=0;i<machines.length;i++){
    var m = machines[i];
    if(!m) continue;
    var id = String(m.id);
    var base = baseMarketPrice(m);
    if(!clubMarketState.prices[id]){
      clubMarketState.prices[id] = { price: base, change: 0, history: [base, base, base, base, base, base, base] };
    }
    var p = clubMarketState.prices[id];
    if(!p.history || p.history.length < 7){
      p.history = p.history || [];
      while(p.history.length < 7) p.history.unshift(p.price || base);
    }
    if(needNew){
      // daily movement -1.8% .. +2.2% deterministic per day+club
      var seed = 0;
      for(var c=0;c<key.length;c++) seed += key.charCodeAt(c) * (c+1);
      seed += m.id * 9973;
      var r = seededRand(seed);
      var pct = (r * 4.0) - 1.8; // -1.8 to +2.2
      var prev = p.price || base;
      var next = Math.max(15000, Math.round(prev * (1 + pct/100)));
      p.history.push(next);
      if(p.history.length > 14) p.history = p.history.slice(-14);
      p.change = ((next - prev) / prev) * 100;
      p.price = next;
      p.prev = prev;
    } else {
      // recompute change vs previous history point
      var h = p.history;
      if(h.length >= 2){
        var a = h[h.length-2], b = h[h.length-1];
        p.change = a ? ((b-a)/a)*100 : 0;
        p.price = b;
      }
    }
  }
  if(needNew) clubMarketState.dayKey = key;
  saveClubMarket();
}
function setMarketView(mode, btn){
  marketViewMode = mode || "shares";
  var tabs = document.querySelectorAll(".market-tabs button");
  for(var i=0;i<tabs.length;i++) tabs[i].classList.remove("active");
  if(btn) btn.classList.add("active");
