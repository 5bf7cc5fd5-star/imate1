/* ===== Web Push ===== */
function urlBase64ToUint8Array(base64String){
  var padding = "=".repeat((4 - base64String.length % 4) % 4);
  var base64 = (base64String + padding).replace(/-/g, "+").replace(/_/g, "/");
  var rawData = atob(base64);
  var outputArray = new Uint8Array(rawData.length);
  for (var i = 0; i < rawData.length; ++i) outputArray[i] = rawData.charCodeAt(i);
  return outputArray;
}
async function enablePushNotifications(){
  try {
    if(!("Notification" in window) || !("serviceWorker" in navigator)){
      alert("Notifications are not supported on this browser. Use Chrome/Safari on phone.");
      return false;
    }
    var perm = await Notification.requestPermission();
    if(perm !== "granted"){
      alert("Please allow notifications to get deposit and team alerts.");
      return false;
    }
    var reg = await navigator.serviceWorker.ready;
    var vapid = await apiCall("/api/push/vapid-public", "GET");
    if(!vapid || !vapid.publicKey){
      alert("Push not configured on server yet. Deploy latest build with VAPID keys.");
      return false;
    }
    var sub = await reg.pushManager.subscribe({
      userVisibleOnly: true,
      applicationServerKey: urlBase64ToUint8Array(vapid.publicKey)
    });
    var subJson = sub.toJSON();
    await apiCall("/api/push/subscribe", "POST", { subscription: subJson });
    try { localStorage.setItem("imate1_push", "1"); } catch(e){}
    try { toast("Notifications enabled"); } catch(e){}
    return true;
  } catch(e){
    console.warn("push enable", e);
    alert("Could not enable notifications: " + (e.message || e));
    return false;
  }
}
