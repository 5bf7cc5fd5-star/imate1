function listAllPendingDeposits(){
  ensureState();
  var rows = [];
  var seen = {};
  for(var i=0;i<state.users.length;i++){
    var u = state.users[i];
    if(!u || u.isAdmin || u.isSupport) continue;
    var deps = u.deposits || [];
    for(var j=0;j<deps.length;j++){
      var d = deps[j];
      if(!d) continue;
      var st = String(d.status||"").toLowerCase();
      if(st === "pending" || st === "submitted" || st === "awaiting" || st === ""){
        seen[d.id] = 1;
        rows.push({ user: u, dep: d });
      }
    }
  }
  // also global queue
  var g = state.pendingDeposits || [];
  for(var g_i=0; g_i<g.length; g_i++){
    var gitem = g[g_i];
    if(!gitem || String(gitem.status||"pending").toLowerCase() !== "pending") continue;
    if(seen[gitem.depId]) continue;
    var gu = null;
    for(var ui=0; ui<state.users.length; ui++){
      if(state.users[ui].id === gitem.userId){ gu = state.users[ui]; break; }
    }
    if(!gu){
      gu = { id: gitem.userId, name: "Member", phone: "", email: "", deposits: [] };
    }
    rows.push({
      user: gu,
      dep: {
        id: gitem.depId,
        amount: gitem.amount,
        reference: gitem.reference,
        txId: gitem.reference,
        method: gitem.method,
        sender: gitem.sender,
        status: "pending",
        date: gitem.date
      }
    });
  }
  rows.sort(function(a,b){
    return String(b.dep.date||b.dep.created_at||"").localeCompare(String(a.dep.date||a.dep.created_at||""));
  });
  return rows;
}

