function drawChart(points){
  const svg = document.getElementById('chartSvg');
  if(!svg) return;
  if(!points || points.length < 2){
    points = [12,18,15,22,28,24,30,27,33,29,36,32,40,38,42,35,44,41,48,45,52,49,55,50];
  }
  const w=600, h=220, pad=16;
  const max = Math.max.apply(null, points.concat([1]));
  const min = Math.min.apply(null, points);
  const span = Math.max(1, max-min);
  const step = (w - pad*2) / (points.length-1);
  let d = '';
  points.forEach((v,i)=>{
    const x = pad + i*step;
    const y = h - pad - ((v-min)/span)*(h-pad*2);
    d += (i? ' L ':'M ') + x.toFixed(1) + ' ' + y.toFixed(1);
  });
  const area = d + ' L ' + (w-pad) + ' ' + (h-pad) + ' L ' + pad + ' ' + (h-pad) + ' Z';
  svg.innerHTML = `
    <defs><linearGradient id="g" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#3b82f6" stop-opacity="0.45"/>
      <stop offset="100%" stop-color="#3b82f6" stop-opacity="0"/>
    </linearGradient></defs>
    <path d="${area}" fill="url(#g)"/>
    <path d="${d}" fill="none" stroke="#60a5fa" stroke-width="3" stroke-linejoin="round"/>
  `;
}

