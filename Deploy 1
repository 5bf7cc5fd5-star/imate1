function ugandaNow(){ return new Date(); }
function daysBetween(startIso, endDate){
  var s = new Date(startIso);
  try { s = new Date(new Date(startIso).toLocaleString("en-US", { timeZone: "UTC" })); } catch(e){}
  var e = endDate || ugandaNow();
  var s0 = new Date(s.getFullYear(), s.getMonth(), s.getDate());
  var e0 = new Date(e.getFullYear(), e.getMonth(), e.getDate());
  return Math.max(0, Math.floor((e0 - s0) / 86400000));
}
function eatNow(){
  try {
    return new Date(new Date().toLocaleString("en-US", { timeZone: "Africa/Nairobi" }));
  } catch(e){ return new Date(); }
}
function compoundsElapsed(m){
  if(!m || !m.start) return 0;
  try {
    // Daily coupon compounds at 13:00 East Africa Time
    var start = new Date(m.start);
    var sEat = new Date(start.toLocaleString("en-US", { timeZone: "Africa/Nairobi" }));
    var nowEat = eatNow();
    // First compound after start date at 13:00 EAT
    var first = new Date(sEat.getFullYear(), sEat.getMonth(), sEat.getDate(), 13, 0, 0);
    if(sEat.getHours() >= 13) first = new Date(sEat.getFullYear(), sEat.getMonth(), sEat.getDate()+1, 13, 0, 0);
    if(nowEat < first) return 0;
    var ms = nowEat.getTime() - first.getTime();
    var days = Math.floor(ms / 86400000) + 1;
    return Math.max(0, days);
  } catch(e){ return 0; }
}
function principalWithBonus(price){
  return Math.round(Number(price) * (1 + BONUS_RATE) * 100) / 100;
}
function compoundValue(principal, compounds){
  // legacy name — now fixed daily withdraw model
  return Number(principal)||0;
}
function machineDailyWithdraw(m){
  if(!m) return 0;
  if(m.dailyWithdraw != null) return Number(m.dailyWithdraw);
  if(m.daily != null && Number(m.daily) > 100) return Number(m.daily);
  // Prefer lock duration (7/14/21/28), then pack price
  var ld = Number(m.lockDays || 0);
  if(ld) return dailyWithdrawForDays(ld);
  return dailyWithdrawForPrice(m.price || m.principal || 0);
}
function machineCurrentValue(m){
  var principal = m.principal != null ? m.principal : Number(m.price||0);
  var lockDays = Number(m.lockDays || 7);
  var days = Math.min(compoundsElapsed(m), lockDays);
  var daily = machineDailyWithdraw(m);
  // Locked pot grows by fixed daily withdraw amount each day
  return Math.round((Number(principal) + daily * days) * 100) / 100;
}
function machineProjectedFinal(m){
  var principal = m.principal != null ? m.principal : Number(m.price||0);
  var lockDays = Number(m.lockDays || 7);
  var daily = machineDailyWithdraw(m);
  return Math.round((Number(principal) + daily * lockDays) * 100) / 100;
}
function machineEarned(m){
  return Math.max(0, machineCurrentValue(m) - Number(m.price|| m.principal || 0));
}

function calcBalances(user){
  if(user.machines){
    for(var i=0;i<user.machines.length;i++){
      var m = user.machines[i];
      var lockDays = Number(m.lockDays || 7);
      var elapsed = compoundsElapsed(m);
      if(!m.credited && elapsed >= lockDays){
        var finalBal = machineProjectedFinal(m);
        user.balance = (user.balance || 0) + finalBal;
        m.credited = true;
        m.finalValue = finalBal;
        user.transactions = user.transactions || [];
        user.transactions.unshift({
          date: new Date().toLocaleString(),
