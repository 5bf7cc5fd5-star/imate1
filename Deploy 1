function submitDeposit(){
  try {
    var user = currentUser(); if(!user){ alert("Please log in first"); return; }
    var amount = Number(document.getElementById("depositAmount").value||0);
    var network = (document.getElementById("depositNetwork").value||"mtn");
    var sender = (document.getElementById("depositSender").value||"").trim();
    var ref = (document.getElementById("depositRef").value||"").trim();
    var confirmBox = document.getElementById("depositTxConfirm");

    if(amount < 3000){ alert("Minimum UGX 3,000"); return; }
    if(network !== "usdt"){
      var digits = normalizePhone(sender);
      if(!digits || digits.length < 9){ alert("Enter the Mobile Money number you paid from"); return; }
    }
    if(!ref || ref.length < 4){ alert("Paste your Transaction ID (TxID) after you pay"); return; }
    if(depositMethod === "mobile" && !slideState.depSlide){ alert("Slide to verify first"); return; }
    var depCap = document.getElementById("depCaptcha");
    if(depositMethod === "mobile" && depCap && !depCap.checked){ alert("Tick I'm not a robot"); return; }
    // map network for mobile
    if(depositMethod === "mobile"){
      network = "mtn";
      var netEl = document.getElementById("depositNetwork");
      if(netEl) network = netEl.value || "mtn";
    } else {
      network = "usdt";
    }
    // basic TxID shape check
    if(/\s{2,}/.test(ref)){ alert("TxID looks invalid — remove extra spaces"); return; }
    if(confirmBox && !confirmBox.checked){
      alert("Tick the box to confirm your Transaction ID is correct (TxID verification step).");
      return;
    }

    // Step: user re-confirms TxID before submit
    var verifyMsg =
      "TXID VERIFICATION\\n\\n"+
      "Amount: UGX "+amount.toLocaleString()+"\\n"+
      "Method: "+(network==="mtn"?"MTN":network==="airtel"?"Airtel":"USDT TRC20")+"\\n"+
      "Transaction ID:\\n"+ref+"\\n\\n"+
      "Confirm this TxID is exactly as shown on your payment receipt?";
    if(!window.confirm(verifyMsg)){
      toast("Submission cancelled — check your TxID");
      return;
    }

    var method = network==="mtn"?"MTN Mobile Money":network==="airtel"?"Airtel Money":"USDT TRC20";
    var depId = "d_" + Date.now();
    var dep = {
      id: depId,
      amount: amount,
      method: method,
      network: network,
      channel: network==="usdt" ? getUsdtDepositAddress(usdtNetwork) : DEPOSIT_MM,
      sender: sender || "—",
      reference: ref,
      txId: ref,
      status: "pending",
      txidUserConfirmed: true,
      txidAdminVerified: false,
      date: new Date().toLocaleString(),
      created_at: new Date().toISOString(),
      userId: user.id,
      userName: user.name || "",
      userPhone: user.phone || "",
      userEmail: user.email || ""
    };

    user.deposits = user.deposits || [];
    user.deposits.unshift(dep);
    // Push to server so system panel can see TxID
    try {
      apiCall("/api/deposit", "POST", {
        amount: amount,
        network: network,
        sender: sender,
        reference: ref,
        txid: ref,
        txId: ref
      }).then(function(res){
        if(res && res.deposit && res.deposit.id){
          dep.id = res.deposit.id;
