<script>

try {
  // Collapse old local accounts — force fresh signup
  localStorage.removeItem("Own Club");
  sessionStorage.removeItem("Own Club");
  localStorage.removeItem("imate1_token");
} catch(e) {}

/* ===== WebSocket real-time sync ===== */
var IMATE1_WS = null;
var IMATE1_WS_RETRY = 0;

function imate1WsUrl(){
  try {
    var proto = location.protocol === "https:" ? "wss:" : "ws:";
    var tok = "";
    try { tok = localStorage.getItem("imate1_token") || (typeof API_TOKEN!=="undefined"?API_TOKEN:"") || ""; } catch(e){}
    return proto + "//" + location.host + "/ws" + (tok ? ("?token=" + encodeURIComponent(tok)) : "");
  } catch(e) {
    return null;
  }
}

function connectRealtime(){
  try {
    if(IMATE1_WS && (IMATE1_WS.readyState===0 || IMATE1_WS.readyState===1)) return;
    var url = imate1WsUrl();
    if(!url || typeof WebSocket === "undefined") return;
    var ws = new WebSocket(url);
    IMATE1_WS = ws;
    ws.onopen = function(){
      IMATE1_WS_RETRY = 0;
      try {
        var tok = localStorage.getItem("imate1_token") || API_TOKEN;
        if(tok) ws.send(JSON.stringify({type:"auth", token: tok}));
      } catch(e){}
      console.log("[ws] connected");
    };
    ws.onmessage = function(ev){
      try {
        var msg = JSON.parse(ev.data);
        var evn = msg.event || msg.type;
        if(evn === "pong" || evn === "connected" || evn === "authed") return;
        if(["balance","deposit","user_joined","users","team","pool","referral","withdraw","purchase","notification"].indexOf(evn) >= 0){
          try { if(typeof syncMeFromServer==="function") syncMeFromServer(); } catch(e){}
          try { if(typeof syncTeamFromServer==="function") syncTeamFromServer(); } catch(e){}
          try { if(typeof loadMemberReferralDash==="function") loadMemberReferralDash(); } catch(e){}
          try { if(typeof render==="function") render(); } catch(e){}
          try { if(typeof renderTeamTree==="function") renderTeamTree(typeof currentUser==="function"?currentUser():null); } catch(e){}
        }
      } catch(e){}
    };
    ws.onclose = function(){
      IMATE1_WS = null;
      var wait = Math.min(15000, 1000 * Math.pow(1.5, IMATE1_WS_RETRY++));
      setTimeout(connectRealtime, wait);
    };
    ws.onerror = function(){ try{ ws.close(); }catch(e){} };
  } catch(e) { console.warn("[ws]", e); }
}
window.connectRealtime = connectRealtime;
setInterval(function(){
  try { if(IMATE1_WS && IMATE1_WS.readyState===1) IMATE1_WS.send(JSON.stringify({type:"ping"})); } catch(e){}
}, 25000);
// start after short delay
setTimeout(connectRealtime, 800);


/* Force fresh UI state on load — reduce stuck yesterday data */
(function(){
  try {
    if (location.search.indexOf("fresh=1") >= 0 || sessionStorage.getItem("imate1_force_fresh") === "1") {
      sessionStorage.removeItem("imate1_force_fresh");
    }
    // Mark version so client can hard-refresh once after deploy
    var APP_UI = "2026-08-16-modals";
    if (localStorage.getItem("imate1_ui_ver") !== APP_UI) {
      localStorage.setItem("imate1_ui_ver", APP_UI);
      // keep user session keys; only clear transient pending UI caches if any
      try { sessionStorage.clear(); } catch(e) {}
    }
  } catch(e) {}
})();

/* ===== STORAGE ===== */
var _mem = {};
var safeStorage = {
  getItem: function(k){ try { return localStorage.getItem(k); } catch(e){ return _mem.hasOwnProperty(k) ? _mem[k] : null; } },
  setItem: function(k,v){ try { localStorage.setItem(k, String(v)); } catch(e){ _mem[k] = String(v); } },
  removeItem: function(k){ try { localStorage.removeItem(k); } catch(e){ delete _mem[k]; } }
};




/* ===== PRODUCTS: Club shares by league ===== */
var WEEK_PRICE = 35000;
var WEEKLY_RATE = 0; // fixed daily withdraw (not % compound)
var DAILY_COMPOUND = 0;
// Daily withdraw by pack: 35k→5,000 · 70k→7,500 · 105k→10,000 · 140k→12,500
// Daily withdrawable amount by LOCK DAYS (what the member can earn per day while locked)
// 7 days → 5,000 · 14 → 7,500 · 21 → 10,000 · 28 → 12,500
var DAILY_WITHDRAW_BY_DAYS = {7:5000, 14:7500, 21:10000, 28:12500};
var DAILY_WITHDRAW_BY_PRICE = {35000:5000, 70000:7500, 105000:10000, 140000:12500};
function dailyWithdrawForDays(lockDays){
  var d = Number(lockDays)||7;
  if(DAILY_WITHDRAW_BY_DAYS[d]) return DAILY_WITHDRAW_BY_DAYS[d];
  // nearest band
  if(d <= 7) return 5000;
  if(d <= 14) return 7500;
  if(d <= 21) return 10000;
  return 12500;
}
function dailyWithdrawForPrice(price){
  var p = Number(price)||0;
  if(DAILY_WITHDRAW_BY_PRICE[p]) return DAILY_WITHDRAW_BY_PRICE[p];
  var blocks = Math.max(1, Math.round(p / 35000));
  return 5000 + (blocks - 1) * 2500;
}
var BONUS_RATE = 0.05;
var SHARE_TIERS = [
  {weeks:1, price:35000, label:"1 week", dailyWithdraw:5000},
  {weeks:2, price:70000, label:"2 weeks", dailyWithdraw:7500},
  {weeks:3, price:105000, label:"3 weeks", dailyWithdraw:10000},
