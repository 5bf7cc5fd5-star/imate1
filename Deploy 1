function renderCryptoMarket(){
  var box = document.getElementById("cryptoMarketList");
  if(!box) return;
  // mild live drift
  for(var i=0;i<CRYPTO_SEED.length;i++){
    var c = CRYPTO_SEED[i];
    var d = (Math.random()-0.48)*0.004;
    c.p = Math.max(0.0001, c.p * (1+d));
    c.c = Math.round((c.c + d*100)*100)/100;
  }
  var list = CRYPTO_SEED.slice();
  if(cryptoFilter==="gainers") list = list.filter(function(x){return x.c>=0}).sort(function(a,b){return b.c-a.c});
  if(cryptoFilter==="losers") list = list.filter(function(x){return x.c<0}).sort(function(a,b){return a.c-b.c});
  var h = "";
  for(var j=0;j<list.length;j++){
    var x = list[j];
    var col = x.c>=0 ? "#00d26a" : "#ff4d4d";
    var priceStr = x.p >= 100 ? ("$"+x.p.toLocaleString(undefined,{maximumFractionDigits:2})) : ("$"+x.p.toFixed(x.p<1?6:2));
    h += '<div style="display:flex;align-items:center;gap:10px;padding:12px 4px;border-bottom:1px solid #1a1f24">'+
      '<div style="width:36px;height:36px;border-radius:50%;background:#141a22;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:11px;color:#7ec8ff">'+(x.s.substring(0,2))+'</div>'+
      '<div style="flex:1"><b>'+x.s+'</b><div class="muted" style="font-size:11px">'+x.n+'</div></div>'+
      sparkSvg(x.c)+
      '<div style="text-align:right;min-width:72px"><b>'+priceStr+'</b><div style="color:'+col+';font-size:12px">'+(x.c>=0?'+':'')+x.c.toFixed(2)+'%</div></div>'+
      '</div>';
  }
  box.innerHTML = h;
  if(!cryptoTickTimer){
    cryptoTickTimer = setInterval(function(){
      var p = document.getElementById("marketLive");
      if(p && p.classList.contains("active")) renderCryptoMarket();
    }, 2500);
  }
}

