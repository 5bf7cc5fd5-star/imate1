(function(){
  window._pageStack = window._pageStack || [];
  var _open = window.openModal;
  var _close = window.closeModal;

  window.goBack = function(){
    try {
      if(window._pageStack && window._pageStack.length){
        var id = window._pageStack.pop();
        if(typeof _close === "function") _close(id);
        else if(typeof closeModal === "function") closeModal(id);
        return;
      }
      var open = document.querySelector(".modal.open");
      if(open && open.id){
        if(typeof _close === "function") _close(open.id);
        else if(typeof closeModal === "function") closeModal(open.id);
        return;
      }
      if(typeof goPage === "function") goPage("home");
    } catch(e){ console.warn(e); }
  };
  window.closeModal = function(id){
    try {
      if(id && window._pageStack){
        window._pageStack = window._pageStack.filter(function(x){ return x !== id; });
      }
    } catch(e){}
    if(typeof _close === "function") return _close(id);
  };
  window.openModal = function(id){
    try {
      if(id && window._pageStack && window._pageStack[window._pageStack.length-1] !== id){
        window._pageStack.push(id);
        try { history.pushState({ocModal:id, n: window._pageStack.length}, ""); } catch(e){}
      }
    } catch(e){}
    if(typeof _open === "function") _open(id);
    // bind all back buttons in this modal
    try {
      var m = document.getElementById(id);
      if(m){
        m.querySelectorAll(".back-btn").forEach(function(b){
          b.onclick = function(ev){ ev.preventDefault(); ev.stopPropagation(); window.goBack(); };
        });
      }
    } catch(e){}
  };
  window.addEventListener("popstate", function(){
    try { window.goBack(); } catch(e){}
  });
  document.addEventListener("click", function(ev){
    var b = ev.target && ev.target.closest && ev.target.closest(".back-btn");
    if(!b) return;
    ev.preventDefault();
    ev.stopPropagation();
    window.goBack();
  }, true);
})();

function readLoginFields(){
  var idEl = document.getElementById("loginId") || document.getElementById("authIdent") || document.getElementById("loginEmail");
  var passEl = document.getElementById("loginPass") || document.getElementById("authPass");
  var id = idEl ? String(idEl.value||"").trim() : "";
  var pass = passEl ? String(passEl.value||"").trim() : "";
  if(!id){
    var form = document.getElementById("loginForm");
    if(form){
      var inputs = form.querySelectorAll("input");
      for(var i=0;i<inputs.length;i++){
        var t = (inputs[i].type||"").toLowerCase();
        if(!id && t !== "password" && t !== "checkbox" && inputs[i].value) id = String(inputs[i].value).trim();
        if(!pass && t === "password" && inputs[i].value) pass = String(inputs[i].value).trim();
      }
    }
  }
  if(!id){
    try { id = (localStorage.getItem("imate1_remember_id")||"").trim(); } catch(e){}
  }
  if(!pass){
    try { pass = (localStorage.getItem("imate1_remember_pw")||"").trim(); } catch(e){}
  }
  return {id:id, pass:pass};
}

