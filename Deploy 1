async function act(id, action){
  const note = action==='reject' ? (prompt('Rejection reason (optional):') || '') : '';
  try{
    await api('/api/admin/withdrawals/action', {
      method:'POST',
      body: JSON.stringify({id, action, note})
    });
    var msg = {
      review: 'Marked as Reviewed',
      disburse: 'Disbursed — mark paid offline',
      approve: 'Disbursed',
      reject: 'Rejected — funds returned'
    }[action] || 'Updated';
    try{ alert(msg); }catch(e){}
    loadAll();
  }catch(e){ alert(e.message); }
}

async function depAct(id, action, userId){
  // Server expects: confirm | reject (not "approve")
  var apiAction = (action === 'approve' || action === 'confirm') ? 'confirm' : 'reject';
  const note = apiAction==='reject' ? (prompt('Rejection reason (optional):') || '') : '';
  if(!userId){
    // try find from cache
    var found = (cache.deposits||[]).find(function(d){ return d.id === id; });
    if(found) userId = found.user_id || found.userId;
  }
  if(!userId){ alert('Missing user id for this deposit'); return; }
  try{
    await api('/api/admin/deposits/action', {
      method:'POST',
      body: JSON.stringify({id: id, action: apiAction, user_id: userId, note: note})
    });
    alert(apiAction === 'confirm' ? 'Deposit approved — wallet credited' : 'Deposit rejected');
    loadAll();
  }catch(e){ alert(e.message); }
}

async function creditUser(uid){
  const inp = document.getElementById('cr_'+uid);
  const amount = Number(inp && inp.value);
  if(!amount || amount <= 0){ alert('Enter amount in UGX'); return; }
  try{
    const res = await api('/api/admin/credit', {
      method:'POST',
      body: JSON.stringify({user_id: uid, amount: amount, note: 'Manual credit from company fund pool'})
    });
    // API may wrap single result
    const ok = res && (res.ok !== false) && !res.error;
    const bal = (res && res.balance != null) ? res.balance : (res && res.user && res.user.balance);
    const pool = res && (res.pool_usd != null ? res.pool_usd : null);
    if(inp) inp.value='';
    await loadAll();
    alert('Credited UGX ' + Number(amount).toLocaleString()
      + (bal!=null ? ('\\nNew balance: UGX ' + Number(bal).toLocaleString()) : '')
      + (pool!=null ? ('\\nPool: $' + Number(pool).toLocaleString()) : ''));
  }catch(e){
    alert('Credit failed: ' + (e && e.message ? e.message : e));
  }
}

