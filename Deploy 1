function apiCall(path, method, body){
  var opts = {
    method: method || "GET",
    headers: { "Content-Type": "application/json", "Accept": "application/json" }
  };
  if(API_TOKEN) opts.headers["Authorization"] = "Bearer " + API_TOKEN;
  if(body != null){
    try { opts.body = JSON.stringify(body); }
    catch(e){ return Promise.reject(new Error("Invalid request data")); }
  }
  var ctrl = null;
  try {
    if(typeof AbortController !== "undefined"){
      ctrl = new AbortController();
      opts.signal = ctrl.signal;
      setTimeout(function(){ try{ ctrl.abort(); }catch(e){} }, 25000);
    }
  } catch(e){}
  return fetch(path, opts).then(function(r){
    return r.text().then(function(raw){
      var j = {};
      try { j = raw ? JSON.parse(raw) : {}; }
      catch(e){ throw new Error(r.ok ? "Bad server response" : ("HTTP "+r.status)); }
      if(!r.ok) throw new Error((j && (j.error||j.message)) || ("HTTP "+r.status));
      return j;
    });
  }).catch(function(err){
    var msg = (err && err.name === "AbortError") ? "Request timed out — try again" :
              (err && err.message) ? err.message :
              "Network error — check your connection";
    try { if(typeof toast==="function") toast(msg); } catch(e){}
    throw new Error(msg);
  });
}

