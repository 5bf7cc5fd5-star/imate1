function payReferralLevelsLocal(buyer, investAmount, productName){
  try {
    if(!buyer || !state || !state.users) return;
    var rates = [0.30, 0.25, 0.20, 0.15];
    var amount = Number(investAmount||0);
    if(amount <= 0) return;
    var parentId = buyer.referredBy || buyer.referred_by;
    for(var level=0; level<rates.length; level++){
      if(!parentId) break;
      var parent = null;
      for(var i=0;i<state.users.length;i++){
        if(state.users[i] && state.users[i].id === parentId){ parent = state.users[i]; break; }
      }
      if(!parent) break;
      var reward = Math.round(amount * rates[level]);
      if(reward > 0){
        parent.balance = Number(parent.balance||0) + reward;
        parent.referralEarnings = Number(parent.referralEarnings||parent.referral_earnings||0) + reward;
        parent.referral_earnings = parent.referralEarnings;
        parent.referralPayouts = parent.referralPayouts || parent.referral_payouts || [];
        parent.referralPayouts.unshift({
          date: new Date().toLocaleString(),
          from: buyer.name || buyer.id,
          from_id: buyer.id,
          level: level+1,
          rate: rates[level],
          machine: productName || "Club share",
          invest_amount: amount,
          amount: reward
        });
        parent.referral_payouts = parent.referralPayouts;
        parent.transactions = parent.transactions || [];
        parent.transactions.unshift({
          date: new Date().toLocaleString(),
          type: "L"+(level+1)+" referral "+Math.round(rates[level]*100)+"% — "+(buyer.name||"member"),
          amount: reward
        });
      }
      parentId = parent.referredBy || parent.referred_by;
    }
  } catch(e){ console.warn(e); }
}
window.payReferralLevelsLocal = payReferralLevelsLocal;

