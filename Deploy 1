function showSysError(msg){
  try {
    var b = document.getElementById('sysErr');
    if(!b){
      b = document.createElement('div');
      b.id = 'sysErr';
      b.style.cssText = 'position:fixed;top:12px;right:12px;z-index:80;background:#fee2e2;color:#991b1b;border:1px solid #fecaca;padding:10px 14px;border-radius:10px;font-size:13px;max-width:360px;box-shadow:0 8px 20px rgba(0,0,0,.08)';
      document.body.appendChild(b);
    }
    b.textContent = String(msg||'Error');
    b.style.display = 'block';
    clearTimeout(window._sysErrT);
    window._sysErrT = setTimeout(function(){ b.style.display='none'; }, 5000);
  } catch(e){}
}
async function api(path, opts={}){
  const headers = Object.assign({'Content-Type':'application/json','Accept':'application/json'}, opts.headers||{});
  if(token) headers['Authorization'] = 'Bearer ' + token;
  let res;
  try {
    res = await fetch(API + path, Object.assign({}, opts, { headers }));
  } catch (netErr) {
    throw new Error('Cannot reach server. Check internet / Railway is online. (' + (netErr && netErr.message ? netErr.message : 'network') + ')');
  }
  const raw = await res.text();
  let data = {};
  try { data = raw ? JSON.parse(raw) : {}; } catch(e) { data = { error: raw || ('HTTP '+res.status) }; }
  if(res.status === 401){ logout(); throw new Error(data.error || 'Unauthorized'); }
  if(!res.ok){
    var em = data.error || data.message || ('HTTP '+res.status);
    showSysError(em);
    throw new Error(em);
  }
  return data;
}

