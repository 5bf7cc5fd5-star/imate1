window.doLogin = function(){
  try { if(typeof ensureState==="function") ensureState(); } catch(e){}
  var f = (typeof readLoginFields==="function") ? readLoginFields() : {id:"",pass:""};
  var id = (f.id||"").trim();
  var pass = (f.pass||"").trim();
  if(!id){
    var a = document.getElementById("loginId");
    if(a) id = String(a.value||"").trim();
  }
  if(!pass){
    var b = document.getElementById("loginPass");
    if(b) pass = String(b.value||"").trim();
  }
  if(!id){ console.warn("login empty id"); return; }
  if(!pass){ console.warn("login empty pass"); return; }

  var rem = document.getElementById("rememberMe");
  try {
    if(!rem || rem.checked){
      localStorage.setItem("imate1_remember","1");
      localStorage.setItem("imate1_remember_id", id);
      localStorage.setItem("imate1_remember_pw", pass);
    } else {
      localStorage.removeItem("imate1_remember");
      localStorage.removeItem("imate1_remember_id");
      localStorage.removeItem("imate1_remember_pw");
    }
  } catch(e){}

  function finishLocal(user){
    try {
      state.currentUserId = user.id;
      if(typeof saveState==="function") saveState();
      if(typeof showApp==="function") showApp();
      else {
        var auth = document.getElementById("authScreen") || document.getElementById("loginWrap");
        var app = document.getElementById("mainApp") || document.getElementById("app");
        if(auth) auth.classList.add("hidden");
        if(app) app.classList.remove("hidden");
      }
      if(typeof goPage==="function") goPage("home");
      if(typeof render==="function") render();
    } catch(e){ console.warn(e); }
  }

  // Server login first — no extra popup
  if(typeof apiCall === "function"){
    apiCall("/api/login", "POST", { email: id, phone: id, password: pass }).then(function(res){
      if(res && res.token){
        try { localStorage.setItem("imate1_token", res.token); } catch(e){}
      }
      if(res && res.user){
        try {
          if(typeof mergeServerUser==="function") mergeServerUser(res.user);
          else {
            var found = null;
            state.users = state.users || [];
            for(var i=0;i<state.users.length;i++){
              if(state.users[i].email && String(state.users[i].email).toLowerCase()===String(res.user.email||"").toLowerCase()){
                found = state.users[i]; break;
              }
            }
            if(!found){
              found = { id: res.user.id, email: res.user.email, phone: res.user.phone, name: res.user.name, balance: res.user.balance||0, machines:[], transactions:[], deposits:[], withdrawals:[] };
              state.users.push(found);
            }
            found.serverId = res.user.id;
            found.isAdmin = !!(res.user.is_admin);
            found.isSupport = !!(res.user.is_support);
            found.isStaff = !!(res.user.is_staff);
            found.inviteCode = res.user.invite_code || found.inviteCode;
            finishLocal(found);
            try { if(typeof syncMeFromServer==="function") syncMeFromServer(); } catch(e){}
            try { if(typeof syncTeamFromServer==="function") syncTeamFromServer(); } catch(e){}
            return;
          }
        } catch(e){ console.warn(e); }
      }
      if(res && res.user){
        var u2 = null;
        for(var j=0;j<(state.users||[]).length;j++){
          if(state.users[j].id===res.user.id || (state.users[j].email||"").toLowerCase()===(res.user.email||"").toLowerCase()){
            u2 = state.users[j]; break;
          }
        }
        if(u2) finishLocal(u2);
      }
    }).catch(function(){
      // local fallback
      var needle = id.toLowerCase().replace(/\s+/g,"");
      var users = (state && state.users) || [];
      for(var i=0;i<users.length;i++){
        var u = users[i];
        if(!u) continue;
        var em = String(u.email||"").toLowerCase();
        var ph = String(u.phone||"").replace(/\D/g,"");
        var okId = em===needle || ph===needle.replace(/\D/g,"") || String(u.phone||"").replace(/\s+/g,"")===needle;
        var okPw = String(u.password||"")===pass;
        if(okId && okPw){ finishLocal(u); return; }
      }
    });
    return;
  }
};

