function ugxToLocal(ugx, user){
  var c = userCurrency(user);
  if(c.code === "UGX") return Math.round(Number(ugx)||0);
  var ugxPerUsd = ratePerUSD("UGX") || 3700;
  var usd = Number(ugx) / ugxPerUsd;
  return Math.round(fromUSD(usd, user));
}

